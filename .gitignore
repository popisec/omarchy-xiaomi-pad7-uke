*.dtb
*.dng
*.raw
*.tar
*.tar.*
*.zip
*.apk
*.log
*.pem
*.key
id_*
!id_*.pub
build/rootfs/uke-arch-root*
build/bootimg/
# build/android/ entero (blobs del fabricante y volcados de la tablet), pero
# con una excepcion: el manifiesto de SHA256 del lapiz SI se versiona, porque
# el sha es lo que se publica, no el fichero. Ojo: la excepcion solo funciona
# si el DIRECTORIO no esta ignorado ("build/android/**" en vez de
# "build/android/"), porque git no baja a un directorio excluido.
build/android/**
!build/android/lapiz-*/
!build/android/lapiz-*/binarios/
!build/android/lapiz-*/binarios/SHA256.txt
build/backup/
build/stage-escritorio/
build/vendor-re/
out/
**/out/
**/out-*/
# Solo las capturas que se generan al hacer deploy; las que se citan en
# los informes (build/gates/revision/capturas-*) se versionan.
build/rootfs/deploy/*/out/capturas-*/
build/logs/**/capturas-*/
**/etc/shadow*
**/etc/gshadow*
**/ssh_host_*
**/system-connections/

# Salida de kbuild/make (modpost, .cmd, .symvers): se regenera en cada build.
# No aportan nada al repo y filtran rutas del arbol de compilacion local.
*.cmd
*.mod.c
*.mod.o
*.symvers
*.o.d
