+	/* ===== UKE-K61: escala del S3 (module_param uke_s3_stage) ==========
+	 * 0: NO soltar (fail-closed): solo sondas de entorno, salida -EAGAIN
+	 * 1: soltar + 50 ms + UNA lectura + re-assert + -EAGAIN
+	 * 2: soltar + 200 ms + autopsia completa + re-assert + -EAGAIN
+	 * 3: flujo original (poll 100 ms) — sigue abajo */
+	UKE61_NOTE("DISPATCH: uke_s3_stage=%d", uke_s3_stage);
+	switch (uke_s3_stage) {
+	case 0:
