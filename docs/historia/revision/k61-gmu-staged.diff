+/* UKE-K61: canal unico de marcador persistente. pr_err -> printk -> consola
+ * pstore de ramoops (escritura SINCRONA en el buffer @0xa7000000: lo que pasa
+ * por aqui sobrevive a un reset duro) + pr_flush (espera a que la linea este
+ * en el wire de la UART). Todo veredicto del k61 pasa por AQUI. */
+#define UKE61_NOTE(fmt, ...) do { \
+	pr_err("UKE-K61: " fmt "\n", ##__VA_ARGS__); \
+	pr_flush(120, false); \
+} while (0)
