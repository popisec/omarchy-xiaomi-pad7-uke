+		uke_k61_rescue_write("STAGE0-NOGO", 0, 0);
+		set_bit(GMU_STATUS_FW_START, &gmu->status);
+		return -EAGAIN;
+	case 1:
+		return uke_k61_stage_release(gmu, 1, 50);
+	case 2:
+		return uke_k61_stage_release(gmu, 2, 200);
