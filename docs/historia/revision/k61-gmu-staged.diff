+	uke_k61_rescue_write("STAGE3-ARM", 3, 0);
 	gmu_write(gmu, REG_A6XX_GMU_CM3_SYSRESET, 0);
 	uke_poke("S3-rst0");
 	/* UKE-K23b: uke_poke() solo escribe en el framebuffer y hace pr_info SIN
@@ -774,6 +1128,12 @@
 		gmu_write(gmu, REG_A6XX_GMU_CM3_SYSRESET, 1);
 		pr_err("UKE-K56 C: poll FAIL -> SYSRESET re-assertado\n");
