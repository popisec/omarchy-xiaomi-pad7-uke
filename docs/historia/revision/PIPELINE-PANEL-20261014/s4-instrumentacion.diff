 	}
 }
 
@@ -1633,6 +1651,9 @@
 	if (status) {
 		dsi_write(msm_host, REG_DSI_FIFO_STATUS, status);
 		msm_host->err_work_state |= DSI_ERR_STATE_FIFO;
