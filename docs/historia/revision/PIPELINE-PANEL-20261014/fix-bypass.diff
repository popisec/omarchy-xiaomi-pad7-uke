+/*
+ * UKE-FIX-A2 (14-oct-2026, sesion FIX): BYPASS discriminante del display.
+ * Igual reclaim que FIX-A1 (localiza la entrada BL del SID 0x1c00/0x2 por
+ * lectura SMR y la reutiliza), pero install_s2crs la lleva a S2CR_TYPE_BYPASS
+ * en vez de TRANS: el fetch del cmd-DMA lee PA directa y NO debe matar.
+ * Si el DCS completa (basura) => causa-traduccion confirmada; si la muerte es
+ * identica => la causa NO es la traduccion. Diagnostico de 1 ciclo (el
+ * scanout exige traduccion). Requiere uke_write_mask con bits 6+7 (el CB69 de
+ * bit8 sobra pero se deja 0x1C0 para igual setup que A1). Mutuamente
+ * excluyente con uke_disp_reclaim (no aplicar fix-smmu.diff + este).
+ */
+static bool uke_disp_bypass;
+
+module_param(uke_disp_bypass, bool, 0644);
+MODULE_PARM_DESC(uke_disp_bypass,
+	"UKE (FIX-A2): 1 = la entrada reclamada del display (0x1c00/0x2) va a BYPASS un ciclo. Solo diagnostico.");
 
