 static void o82_reset(struct o82_panel *ctx)
 {
+	/* S3 (fidelidad Android, ex-L27 §E.3): el gpio llega en Hi-Z desde el
+	 * probe (Android no lo toca hasta power_on); tomar direccion aqui. */
+	gpiod_direction_output(ctx->reset_gpio, 1);
 	uke_poke("K48-rst-A");	/* fisico: ASSERT (gpiod1=LOW) */
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 	uke_poke("K48-w1-done");
@@ -279,8 +282,10 @@
 	pr_info("UKE-P82: rst: assert2(3ms) OK\n");
 	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
 	uke_poke("K48-w4-done");
-	usleep_range(100000, 101000);	/* r7: 15->100ms, discriminador temporal */
-	uke_poke("K48-rst-R2-ok");	/* RELEASE final 100ms */
+	/* S3 (ex-L27 §E.5 + §B.3): el vendor usa 15 ms finales
+	 * (0/10,1/3,0/3,1/15); los 100 ms eran el discriminador r7. */
+	usleep_range(15000, 15500);
+	uke_poke("K48-rst-R2-ok");	/* RELEASE final 15ms (vendor) */
 	pr_info("UKE-P82: rst: release2(15ms) OK — reset COMPLETO\n");
 }
 
