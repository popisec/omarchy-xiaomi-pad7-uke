 /* Delay for the transmit to wait before sending an unfilled NTB frame. */
 #define TX_TIMEOUT_NSECS	300000
 
+/* L50-contingencia (diagnostico): con =1, ncm_wrap_ntb() empaqueta y
+ * devuelve el NTB en la misma llamada (sin esperar al hrtimer de
+ * 300 us), para que el netpoll/netconsole ponga los bits en el cable
+ * de forma sincrona aunque el SoC se clave justo despues. Se activa
+ * en runtime: echo 1 > /sys/module/usb_f_ncm/parameters/ncm_sync_flush
+ * (defecto 0 = batching normal). Solo para un ciclo de captura. */
+static bool ncm_sync_flush;
+module_param(ncm_sync_flush, bool, 0644);
+MODULE_PARM_DESC(ncm_sync_flush, "flush synchronously, no NTB batching (diagnostic)");
+
