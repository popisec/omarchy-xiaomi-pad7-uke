--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -33,8 +33,6 @@
 #include "msm_gem.h"
 #include "phy/dsi_phy.h"
 
-#define DSI_RESET_TOGGLE_DELAY_MS 20
-
 static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc_config *dsc);
 
 static int dsi_get_version(const void __iomem *base, u32 *major, u32 *minor)
@@ -1145,7 +1143,24 @@
 
 	/* dsi controller can only be reset while clocks are running */
 	dsi_write(msm_host, REG_DSI_RESET, 1);
-	msleep(DSI_RESET_TOGGLE_DELAY_MS); /* make sure reset happen */
+	/*
+	 * S2-G8 (14-oct-2026): pulso de reset de 1 us, como el vendor.
+	 *
+	 * Evidencia (msm_drm.ko de Android, no stripped):
+	 * dsi_ctrl_hw_cmn_soft_reset escribe RESET=1, luego
+	 *   mov w0, #0x10c7 (=4295) ; bl __const_udelay
+	 * (file-offset 0x12d4ac/0x12d4b0; reubicacion R_AARCH64_CALL26 a
+	 * __const_udelay), y despues RESET=0. En arm64
+	 * arch/arm64/lib/delay.c define udelay(n) como
+	 * __const_udelay(n * 0x10C7UL), asi que __const_udelay(0x10C7)
+	 * ES udelay(1). El msleep(20) anterior era x20.000 el pulso del
+	 * vendor en este mismo punto del prepare (tras LINK_CLK, antes de
+	 * panel_prepare/DCS). El restore de CTRL se deja intacto a proposito:
+	 * el vendor tambien restaura integro en este path (soft_reset); el
+	 * restore sin VID es del otro reset (ctrl_reset, host_init) y es el
+	 * sub-ciclo H5-5a, no este.
+	 */
+	udelay(1); /* make sure reset happen */
 	dsi_write(msm_host, REG_DSI_RESET, 0);
 	wmb(); /* controller out of reset */
 
