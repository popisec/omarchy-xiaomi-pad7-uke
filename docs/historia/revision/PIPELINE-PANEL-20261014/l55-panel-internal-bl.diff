+ * o82_bl_update_status() escribe el nivel por DCS 0x51 en ambos links
+ * (12 bits, MSB first); sin PWM ("bl_ctrl_external" del vendor).
+ * Matiz medido: el init vendor (pagina 0x10, este fichero) SI programa
+ * 0x51 = 0x0FFF + 0x53 = 0x24 al arrancar; lo que nunca usa es el 0x51 en
+ * RUNTIME (ahi va por KTZ: dsi_panel_set_backlight() case 3). El 0x53 = 0x24
+ * deja armado el path DCS: el 0x51 de runtime es un camino no intentado con
+ * video vivo. Coexistencia: el DT (s287) sigue trayendo
+ * 'backlight = <&ktz_bl_0>' pero NO se reclama (sin drm_panel_of_backlight,
+ * ctx->panel.backlight = NULL): el KTZ queda huerfano sin updates del core
+ * y NO hay doble update. Sin cambios de DT, KTZ ni SMMU.
+ * Vendor: qcom,mdss-dsi-bl-min-level = <4>, bl-max-level = <0xfff> (12 bit,
+ * written through DCS 0x51, "bl_ctrl_external" = no PWM).
  */
+#define O82_BL_MIN_LEVEL	4
+#define O82_BL_MAX_LEVEL	0xfff
+/* Vendor: qcom,mdss-brightness-init-level = <0x133>. */
+#define O82_BL_INIT_LEVEL	0x133
 /* Vendor: qcom,supply-enable-load of the three panel supply entries. */
 #define O82_SUPPLY_ENABLE_LOAD_UA	300000
 
