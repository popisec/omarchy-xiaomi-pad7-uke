+static void qcom_pas_proxy_unvote(struct qcom_pas *pas, int count)
 {
+	while (count--) {
+		int ret = regulator_set_voltage(pas->proxy_regs[count].consumer,
+						0, INT_MAX);
+
+		if (ret)
+			dev_err(pas->dev, "failed to release %s proxy vote: %d\n",
+				pas->proxy_regs[count].supply, ret);
+	}
+}
+
+static int qcom_pas_proxy_enable(struct qcom_pas *pas)
+{
+	struct device **pds = pas->proxy_pds;
+	int pd_count = pas->proxy_pd_count;
 	int ret;
 	int i;
 
+	if (pas->proxy_regulator_level) {
+		for (i = 0; i < ARRAY_SIZE(pas->proxy_regs); i++) {
+			ret = regulator_set_voltage(pas->proxy_regs[i].consumer,
+						pas->proxy_regulator_level, INT_MAX);
+			if (ret) {
+				qcom_pas_proxy_unvote(pas, i);
+				return ret;
+			}
+		}
+		ret = regulator_bulk_enable(ARRAY_SIZE(pas->proxy_regs), pas->proxy_regs);
+		if (ret)
+			qcom_pas_proxy_unvote(pas, ARRAY_SIZE(pas->proxy_regs));
+		return ret;
+	}
+
 	for (i = 0; i < pd_count; i++) {
