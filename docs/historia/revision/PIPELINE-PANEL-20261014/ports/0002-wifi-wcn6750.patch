 };
+
+/* ---- WIFI WCN6750 (port senemos rev 1.39, 15-oct-2026): rieles RF directos ----
+ * Referencia en-arbol; el despliegue real va por frags dtbo (1701 wifi + rails).
+ * DISABLED hasta cerrar pantalla (frags wifi wedgean, ledger #601).
+ * Mapeo medido (senemos uke-abl.c + DT OEM de uke): vdd-cx-mx -> smpb3
+ * (984000 uV), vdd-1.8-xo -> smpb1 (1856000 uV), vdd-1.3-rfa -> smpb2
+ * (1256000 uV); los rangos de vreg_s3b/s1b/s2b de este dts los contienen
+ * (968-1040 / 1856-2040 / 1256-1408 mV). wpss: cx-supply = frag 1707 (s3b);
+ * mx-supply pendiente (lo exige el patch 0003: NO aplicarlo sin ese supply).
+ */
+&wifi {
+	compatible = "xiaomi,uke-wcn6750-wifi", "qcom,wcn6750-wifi";
+	vdd-cx-mx-supply = <&vreg_s3b_1p04>;
+	vdd-1.8-xo-supply = <&vreg_s1b_2p04>;
+	vdd-1.3-rfa-supply = <&vreg_s2b_1p4>;
+	status = "disabled";
+};
+
+&remoteproc_wpss {
+	compatible = "qcom,cliffs-wpss-pas";
+	firmware-name = "qca6750/wpss.mdt";
+	cx-supply = <&vreg_s3b_1p04>;
+	status = "disabled";
+};
diff -ur a/drivers/net/wireless/ath/ath11k/ahb.c b/drivers/net/wireless/ath/ath11k/ahb.c
--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -402,6 +402,52 @@
 	ath11k_ce_cleanup_pipes(ab);
 }
 
+/* Uke/WCN6750 (port de senemos 0015-uke-wlan-supplies-and-dma.patch y
+ * 0016-uke-wlan-ordered-rails.patch, rev 1.39): rieles RF directos en el
+ * propio nodo wifi, sin pasar por el PMU/pwrseq. Solo se activa con el
+ * compatible "xiaomi,uke-wcn6750-wifi"; el resto de placas queda igual.
+ * La via pwrseq existente se conserva para DTs antiguos.
+ */
+static int ath11k_ahb_uke_regulators(struct ath11k_base *ab)
+{
+	static const char * const names[] = { "vdd-cx-mx", "vdd-1.8-xo", "vdd-1.3-rfa" };
+	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
+	int i, ret;
+
+	if (!of_device_is_compatible(ab->dev->of_node, "xiaomi,uke-wcn6750-wifi"))
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		char property[32];
+
+		snprintf(property, sizeof(property), "%s-supply", names[i]);
+		if (!of_property_present(ab->dev->of_node, property))
+			return dev_err_probe(ab->dev, -EINVAL, "Uke WLAN requires all three RF supplies\n");
+		ab_ahb->uke_regs[i].supply = names[i];
+	}
+	ret = devm_regulator_bulk_get(ab->dev, ARRAY_SIZE(ab_ahb->uke_regs), ab_ahb->uke_regs);
+	if (ret)
+		return dev_err_probe(ab->dev, ret, "Uke WLAN RF supplies unavailable\n");
+	ab_ahb->uke_supplies = true;
+	return 0;
+}
+
+static void ath11k_ahb_uke_regulators_off(struct ath11k_base *ab)
+{
+	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
+	int ret;
+
+	/* OEM ICNSS: apagado en orden inverso; ante un fallo se conserva el
+	 * prefijo encendido para no re-votar un rail ya activo al reintentar. */
+	while (ab_ahb->num_uke_regs_enabled) {
+		ret = regulator_disable(ab_ahb->uke_regs[ab_ahb->num_uke_regs_enabled - 1].consumer);
+		if (ret) {
+			ath11k_err(ab, "failed to release Uke WLAN RF supplies: %d\n", ret);
+			return;
+		}
+		ab_ahb->num_uke_regs_enabled--;
+	}
+}
+
 static int ath11k_ahb_power_up(struct ath11k_base *ab)
 {
 	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
@@ -418,9 +464,21 @@
 		}
 	}
 
+	/* OEM ICNSS enciende CX/MX, XO y luego RFA; el bulk_enable va en paralelo. */
+	while (ab_ahb->uke_supplies && ab_ahb->num_uke_regs_enabled < ARRAY_SIZE(ab_ahb->uke_regs)) {
+		ret = regulator_enable(ab_ahb->uke_regs[ab_ahb->num_uke_regs_enabled].consumer);
+		if (ret) {
+			ath11k_ahb_uke_regulators_off(ab);
+			return ret;
+		}
+		ab_ahb->num_uke_regs_enabled++;
+	}
+
 	ret = rproc_boot(ab_ahb->tgt_rproc);
-	if (ret)
+	if (ret) {
 		ath11k_err(ab, "failed to boot the remote processor Q6\n");
+		ath11k_ahb_uke_regulators_off(ab);
+	}
 
 	return ret;
 }
