+/* ---- touch Novatek NT36532 (QUP0 SE4 SPI, INT tlmm gpio54) ----
+ * Espejo del nodo vendor del DTBO stock (fragment@35 -> spi@a90000/
+ * novatek@0): compatible/CS/freq exactos; INT via interrupts-extended
+ * (el vendor usa novatek,irq-gpio <&tlmm 54 0x2001> + gpio_to_irq).
+ * 0x2001 = IRQF_ONESHOT | EDGE_RISING (flags Linux del .ko vendor,
+ * verificado en fase4-touch.dts del staging hermano); si no hay eventos,
+ * probar IRQ_TYPE_EDGE_FALLING (1 linea). Sin reset-gpios ni supplies:
+ * TDDI, los rieles van con el panel (el driver los trata como opcionales).
+ * Pines del bus (MISO16/MOSI17/CLK18/CS19, qup0_se4) ya muxados por
+ * qup_spi4_data_clk/cs de palawan.dtsi: este bloque no anade pinctrl.
+ * NOTA DE RUTA: mientras el arranque use DTBO derivado del vendor, el nodo
+ * vivo lo aporta el DTBO y este bloque solo vale para el DT nativo futuro;
+ * en la ruta DTBO el fix es el overlay fase4-touch.dts (staging hermano),
+ * que anade interrupts al novatek@0 existente. */
+&spi4 {
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "novatek,NVT-ts-spi";
+		reg = <0>;
+
+		spi-max-frequency = <19200000>;
+		interrupts-extended = <&tlmm 54 IRQ_TYPE_EDGE_RISING>;
+
+		/* abs_x_max=2136, abs_y_max=3200 (dmesg vendor); el IC
+		 * reporta records de 12 bits. Si evtest muestra ejes
+		 * permutados, intercambiar size-x/size-y. */
+		touchscreen-size-x = <2136>;
+		touchscreen-size-y = <3200>;
+
+		status = "okay";
+	};
+};
+
