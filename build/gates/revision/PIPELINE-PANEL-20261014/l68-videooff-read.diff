--- a/drivers/gpu/drm/panel/panel-xiaomi-o82-dualdsi.c
+++ b/drivers/gpu/drm/panel/panel-xiaomi-o82-dualdsi.c
@@ -35,6 +35,10 @@
 #include <video/mipi_display.h>
 
+/* L68 (uke): helper del host DSI para parar/arrancar el motor de video.
+ * Vive en drivers/gpu/drm/msm/dsi/dsi_host.c (ambos built-in). */
+extern void msm_dsi_host_video_engine_set(struct mipi_dsi_host *host, bool on);
+
 /* Brillo: EXTERNO (Kinetic KTZ8866 por I2C, "bl_ctrl_external" del vendor).
  * El vendor NUNCA escribe DCS 0x51 en este panel (ID 0x14):
@@ -685,6 +689,50 @@ static int o82_enable(struct drm_panel *panel)
 			pr_info("UKE-L65: DCS read 0x04 link%d = 0x%02X 0x%02X 0x%02X (ret=%zd)\n",
 				li, id[0], id[1], id[2], r);
 		}
 	}
 
+	/*
+	 * L68 (15-oct): MISMO bloque de lecturas con el MOTOR DE VIDEO PARADO.
+	 * Contexto del cold-path vendor (108 DCS con vid_engine OFF); el vendor
+	 * lee poco y siempre con el panel gobernado, y sus diagnosticos en vivo
+	 * tambien fallaron (benignos). Control intra-boot: el bloque L65 de
+	 * arriba corre con video ON; este, con OFF. Criterio: si AQUI responde
+	 * (ret==len) y arriba no, el "sordo" de L67 era contencion de video y
+	 * el DDIC VIVE; si sigue ret<=0 en ambos, el problema es link/RX/panel.
+	 * Riesgo: parar/arrancar VID_MODE_EN en caliente (pantalla ya negra).
+	 */
+	uke_poke("L68-ve");
+	msm_dsi_host_video_engine_set(ctx->dsi[0]->host, false);
+	msm_dsi_host_video_engine_set(ctx->dsi[1]->host, false);
+	usleep_range(100, 200);
+	pr_info("UKE-L68: video engine OFF; leyendo DDIC (contexto vendor)\n");
+	{
+		static const u8 l68_cmds[] = { 0x0A, 0x0B, 0x0C, 0x0D };
+		int li, ci;
+
+		for (li = 0; li < 2; li++) {
+			for (ci = 0; ci < ARRAY_SIZE(l68_cmds); ci++) {
+				u8 val = 0;
+				ssize_t r = mipi_dsi_dcs_read(ctx->dsi[li],
+							      l68_cmds[ci], &val, 1);
+				pr_info("UKE-L68: DCS read 0x%02X link%d = 0x%02X (ret=%zd)\n",
+					l68_cmds[ci], li, val, r);
+			}
+		}
+		for (li = 0; li < 2; li++) {
+			u8 id[3] = { 0, 0, 0 };
+			ssize_t r = mipi_dsi_dcs_read(ctx->dsi[li],
+						      MIPI_DCS_GET_DISPLAY_ID, id, 3);
+			pr_info("UKE-L68: DCS read 0x04 link%d = 0x%02X 0x%02X 0x%02X (ret=%zd)\n",
+				li, id[0], id[1], id[2], r);
+		}
+	}
+	msm_dsi_host_video_engine_set(ctx->dsi[0]->host, true);
+	msm_dsi_host_video_engine_set(ctx->dsi[1]->host, true);
+	pr_info("UKE-L68: video engine ON de vuelta\n");
+
 	if (dsi_ctx.accum_err)
 		return dsi_ctx.accum_err;
 	return 0;
