--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -122,19 +122,26 @@ static void drm_mode_to_intf_timing_params(
 	}
 
 	/*
-	 * for DSI, if compression is enabled, then divide the horizonal active
-	 * timing parameters by compression ratio. bits of 3 components(R/G/B)
-	 * is compressed into bits of 1 pixel.
+	 * L69 (uke, 15-oct-2026): 24 bits de datos comprimidos por pclk
+	 * SIEMPRE. El divisor anterior /(bpc*3) daba 30 con paneles de 10 bpc
+	 * (el nuestro) y producia FIFO errors constantes en el INTF
+	 * (medido: underrun 19 en intf1/intf2 con L67). Commit fuente:
+	 * A. Koskovich, "[PATCH v3 4/4] drm/msm/dpu: fix video mode DSC INTF
+	 * timing width calculation", 19-mar-2026 (patchew 20260319-...).
 	 */
 	if (phys_enc->hw_intf->cap->type != INTF_DP && timing->compression_en) {
 		struct drm_dsc_config *dsc =
 		       dpu_encoder_get_dsc_config(phys_enc->parent);
+
 		/*
 		 * TODO: replace drm_dsc_get_bpp_int with logic to handle
 		 * fractional part if there is fraction
 		 */
-		timing->width = timing->width * drm_dsc_get_bpp_int(dsc) /
-				(dsc->bits_per_component * 3);
+		uke_poke("L69-intf24");
+		timing->width = timing->width * drm_dsc_get_bpp_int(dsc) / 24;
 		timing->xres = timing->width;
 		timing->dce_bytes_per_line = msm_dsc_get_bytes_per_line(dsc);
 	}
 }
