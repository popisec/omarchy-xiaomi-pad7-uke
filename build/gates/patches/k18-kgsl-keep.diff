+static int uke_kgsl_keep = 1;
+module_param(uke_kgsl_keep, int, 0644);
+MODULE_PARM_DESC(uke_kgsl_keep,
+	"UKE (K18): 1 (defecto)=kgsl-smmu conserva estado del BL (omite fases 2/3/4 del reset); 2=omite tambien sCR0 (5-7); 0=reset mainline.");
+
+static bool uke_smmu_es_kgsl(struct arm_smmu_device *smmu)
+{
+	u32 base;
