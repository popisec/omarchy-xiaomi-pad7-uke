+/* UKE-K18: kgsl-smmu (3da0000) = por donde el CM3 del GMU hace fetch (SID 5).
+ * El probe mainline lo resetea de cero y destruye la traduccion del BL/TZ:
+ * al liberar el CM3 (S3-rst0) el primer fetch cuelga el bus (muerte unificada
+ * boot-modeset/eglinfo/modetest). uke_kgsl_keep=1 conserva el estado del BL. */
+static int uke_kgsl_keep = 1;
+module_param(uke_kgsl_keep, int, 0644);
+MODULE_PARM_DESC(uke_kgsl_keep,
+	"UKE (K18): 1 (defecto)=kgsl-smmu conserva estado del BL (omite fases 2/3/4 del reset); 2=omite tambien sCR0 (5-7); 0=reset mainline.");
+
+static bool uke_smmu_es_kgsl(struct arm_smmu_device *smmu)
+{
+	u32 base;
+
+	return smmu->dev->of_node &&
+	       of_property_read_u32(smmu->dev->of_node, "reg", &base) == 0 &&
+	       base == 0x3da0000;
+}
+
+/*
+ * UKE-SMMU-CLK (K3): palanca "sin stream matching" para el apps-smmu.
+ *
+ * ATENCIÓN: mainline NO tiene un campo smmu->stream_matching. El modo stream
+ * matching ES, en este driver, el par (ARM_SMMU_FEAT_STREAM_MATCH en
+ * smmu->features && smmu->smrs != NULL), y se decide en arm_smmu_device_cfg_probe
+ * a partir del bit SMS de IDR0 (arm-smmu.c:1907-1924). "Forzar que no haya stream
+ * matching" = no leer ese bit/limpiarlo, no alojar smmu->smrs y dejar que el
+ * índice de S2CR sea el stream ID crudo (arm_smmu_find_sme: "Stream indexing is
+ * blissfully easy", arm-smmu.c:1113-1115).
+ *
+ * Con uke_stream_match=0, para el apps-smmu (reg=0x15000000) y solo para él:
+ *   - no se aloja smmu->smrs  => arm_smmu_write_sme() NO escribe un solo SMR
+ *     (arm-smmu.c:1061-1066: "if (smmu->smrs) arm_smmu_write_smr(...)");
+ *   - el barrido de SMR de qcom_smmu_cfg_probe se salta (no hay smrs que poblar);
+ *   - arm_smmu_device_reset() fase2 sigue escribiendo S2CR(0..num_mapping_groups-1)
+ *     (arm-smmu.c:1753-1754) pero NINGÚN SMR.
+ *
+ * Qué queda a cambio (importante): el hardware de este aparato declara SMS=1
+ * (ID0=0x4c017e6e), NUMSMRG=110 y NUMSIDB=15. El modo fiel de mainline sería
+ * num_mapping_groups = 1<<NUMSIDB = 32768 => el reset escribiría 32768 S2CR
+ * (0xc00..0x20bfc) y el attach del mdss (SID 0x1c00) S2CR(7168) en 0x7c00:
+ * registros FUERA del banco de S2CR comprobado (0xc00..0xdb8 = S2CR(0..109),
+ * el último lo releyó K2 con éxito). Para que esta palanca no cambie un cuelgue
+ * por otro, K3 deja num_mapping_groups = NUMSMRG (110) — todo acceso del reset y
+ * del quirk queda dentro del banco ya probado — y aloja s2crs con 1<<NUMSIDB
+ * entradas para que un maestro con SID >= 110 no desborde el array al attacharse.
+ * Es una configuración deliberadamente NO fiel a mainline (documentada en
+ * INFORME-K3-BUILD.md): sirve para responder "¿el probe llega al final (bind)
+ * sin tocar ni un SMR?", no para dejar el SMMU traduciendo de verdad.
+ */
+static bool uke_stream_match = true;
+module_param(uke_stream_match, bool, 0644);
+MODULE_PARM_DESC(uke_stream_match,
+	"UKE (K3): 1 (defecto) = stream matching normal; 0 = para el apps-smmu (0x15000000) fuerza el camino stream-indexing sin SMR (ni barrido ni escrituras SMR en el reset).");
+
+/*
+ * UKE-SMMU-CLK (K4): "NO TOCAR lo que dejo el bootloader" (semantica del handoff
+ * del driver vendor: el stock no barre SMR, solo programa los qcom,handoff-smrs).
+ *
+ * CONTEXTO MEDIDO (K2/K3, 28-sep-2026; consola out/uke-ubuntu_console.log [47.71]):
+ * el probe real del apps-smmu SOBREVIVE a IDR0 (0x4c017e6e, SMS=110 grupos),
+ * IDR1 (0x60000047, NUMPAGENDXB=6, 71 CBs), IDR2, a la escritura+relectura del
+ * S2CR(109) del quirk qcom (0x000100ff -> 0x000200ff: quirk=SI) y a la LECTURA de
+ * SMR(0) = 0x80000060 (valid=1, id=0x60, mask=0x8000: un mapeo VIVO del
+ * bootloader). Y MUERE en arm_smmu_device_reset fase2 (arm-smmu.c:1788-1790): el
+ * bucle de arm_smmu_write_sme() x110 que ESCRIBE los 110 S2CR y los 110 SMR.
+ * La ultima miga antes del silencio es "reset fase2 SMR/S2CR x110".
+ *
+ * uke_keep_boot=1 (SOLO apps-smmu, reg=0x15000000, guarda uke_smmu_es_apps()):
+ *   - el reset OMITE ENTERA la fase2: no se escribe NI UN SMR ni UN S2CR (ni clear
+ *     ni repoblar). Los registros del bootloader quedan como estan;
+ *   - arm_smmu_test_smr_masks() (que tambien escribe SMR) tampoco toca el HW:
+ *     se asume el campo MASK completo (ver la funcion) para no romper la
+ *     validacion de arm_smmu_probe_device();
+ *   - el resto de fases dependen de uke_reset_mask (por defecto, con keep_boot=1:
+ *     fases 3, 4 y 5-7 SI, fase2 NO).
+ *
+ * uke_reset_mask (SOLO apps-smmu; bit a 1 = EJECUTAR la fase, bit a 0 = saltarla):
+ *   bit0 = fase2 SMR/S2CR x110          bit2 = fase4 TLBIALLH/TLBIALLNSNH
+ *   bit1 = fase3 CBAR/SCTLR/FSR x71     bit3 = fase5+6+7: RMW de sCR0,
+ *                                               impl->reset y tlb_sync+sCR0
+ * La fase1 (sGFSR) se ejecuta SIEMPRE: es un RMW que reescribe el mismo valor y en
+ * las 3 medidas previas (K1/K2/K3) paso sin incidentes. La mascara efectiva la
+ * calcula uke_reset_mask_efectiva(): el default 0xffff solo cambia (a ~bit0)
+ * cuando uke_keep_boot=1 y el usuario NO ha escrito uke_reset_mask; si el usuario
+ * la escribe, manda ese valor tal cual (asi 0xffff vuelve a activar la fase2).
+ */
+static bool uke_keep_boot;
+static int uke_reset_mask = 0xffff;
+static bool uke_reset_mask_tocado;
+
+#define UKE_RESET_F2		BIT(0)
+#define UKE_RESET_F3		BIT(1)
+#define UKE_RESET_F4		BIT(2)
+#define UKE_RESET_F567		BIT(3)
+#define UKE_RESET_BITS		(UKE_RESET_F2 | UKE_RESET_F3 | UKE_RESET_F4 | UKE_RESET_F567)
+
+static int uke_keep_boot_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (ret)
+		return ret;
+	pr_info("UKE-POKE: uke_keep_boot=%d (solo apps-smmu): fase2 SMR/S2CR %s y test_smr_masks %s\n",
+		uke_keep_boot,
+		uke_keep_boot ? "OMITIDA" : "normal",
+		uke_keep_boot ? "sin tocar HW" : "normal");
+	return 0;
+}
+
+static const struct kernel_param_ops uke_keep_boot_ops = {
+	.set	= uke_keep_boot_set,
+	.get	= param_get_bool,
+};
+
+module_param_cb(uke_keep_boot, &uke_keep_boot_ops, &uke_keep_boot, 0644);
+MODULE_PARM_DESC(uke_keep_boot,
+	"UKE (K4): 1 = apps-smmu (0x15000000): el reset NO escribe ningun SMR ni S2CR (fase2 omitida) y test_smr_masks no toca la region: los mapeos del bootloader quedan intactos. 0 (defecto) = reset mainline.");
+
+static int uke_reset_mask_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_int(val, kp);
+
+	if (ret)
+		return ret;
+	uke_reset_mask_tocado = true;
+	pr_info("UKE-POKE: uke_reset_mask=%d (0x%x, efectivo 0x%x) fijado a mano: fase2=%u fase3=%u fase4=%u fase5-7=%u (1=ejecutar)\n",
+		uke_reset_mask, (unsigned int)uke_reset_mask,
+		(unsigned int)((unsigned int)uke_reset_mask & UKE_RESET_BITS),
+		(uke_reset_mask & UKE_RESET_F2) ? 1u : 0u,
+		(uke_reset_mask & UKE_RESET_F3) ? 1u : 0u,
+		(uke_reset_mask & UKE_RESET_F4) ? 1u : 0u,
+		(uke_reset_mask & UKE_RESET_F567) ? 1u : 0u);
+	return 0;
+}
+
+static const struct kernel_param_ops uke_reset_mask_ops = {
+	.set	= uke_reset_mask_set,
+	.get	= param_get_int,
+};
+
+module_param_cb(uke_reset_mask, &uke_reset_mask_ops, &uke_reset_mask, 0644);
+MODULE_PARM_DESC(uke_reset_mask,
+	"UKE (K4): mascara de fases del reset del apps-smmu (bit0=fase2 SMR/S2CR, bit1=fase3 CBAR/SCTLR/FSR, bit2=fase4 TLBI, bit3=fase5-7 sCR0/impl/tlb); bit a 1 = EJECUTAR. Default 0xffff; con uke_keep_boot=1 y sin tocar, el default pasa a 0xfffe (no fase2).");
+
+/* Mascara efectiva del reset: uke_keep_boot/uke_reset_mask solo afectan al apps-smmu. */
+static u32 uke_reset_mask_efectiva(struct arm_smmu_device *smmu)
+{
+	/* UKE-K18: kgsl-smmu conserva el estado del bootloader; volcado de los
+	 * SMR/S2CR heredados SOLO en probe (nunca runtime — regla 3). */
+	if (uke_smmu_es_kgsl(smmu) && uke_kgsl_keep >= 1) {
+		u32 omit = UKE_RESET_F2 | UKE_RESET_F3 | UKE_RESET_F4;
+		int i;
+
+		if (uke_kgsl_keep >= 2)
+			omit |= UKE_RESET_F567;
+		pr_info("UKE-K18: kgsl-smmu: conservo estado del BL (uke_kgsl_keep=%d, fases omitidas=0x%x)\n",
+			uke_kgsl_keep, omit);
+		for (i = 0; i < 6 && i < smmu->num_mapping_groups; i++)
+			pr_info("UKE-K18: kgsl heredado SMR(%d)=0x%08x S2CR(%d)=0x%08x\n", i,
+				arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_SMR(i)), i,
+				arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_S2CR(i)));
+		return UKE_RESET_BITS & ~omit;
+	}
+
+	if (!uke_smmu_es_apps(smmu))
+		return UKE_RESET_BITS;	/* otros SMMU: reset completo de mainline */
+
+	if (uke_reset_mask_tocado)
+		return (u32)uke_reset_mask & UKE_RESET_BITS;
+
+	if (uke_keep_boot)
+		return UKE_RESET_BITS & ~UKE_RESET_F2;
+
+	return UKE_RESET_BITS;
+}
+
+/*
+ * UKE-SMMU-CLK (K5): instrumentacion y CONTROL de la fase de ATTACH.
+ *
+ * CONTEXTO MEDIDO (K4, 29-sep 00:24; build/gates/k4c-consola-trail.txt):
+ * con uke_keep_boot=1 el probe real SOBREVIVE a todo el reset (fase2 omitida,
+ * fase3 CBAR/SCTLR/FSR x71, TLBI, mmu500_reset, sCR0) y termina con
+ * "test_smr_masks OMITIDO". Justo despues viene iommu_device_register()
+ * (arm-smmu.c:2716) -> drivers/iommu/iommu.c:289 -> bus_iommu_probe()
+ * (iommu.c:1954): el registro del iommu recorre TODOS los devices de
+ * platform_bus y por cada maestro con iommus (69 entradas, ~58 devices, en el
+ * DT del aparato) llama a arm_smmu_probe_device (arm-smmu.c:1727) ->
+ * arm_smmu_master_alloc_smes (1358) -> find_sme (1304) -> arm_smmu_write_sme
+ * (1215): la TORMENTA DE ATTACH. En el trail K4 no se ve NINGUNA miga de
+ * attach: la consola enmudece en el mismo instante (el printk es asincrono:
+ * si la escritura letal llega antes de que el hilo de consola vacie el ring
+ * buffer, la miga se pierde aunque se haya generado).
+ *
+ * DOS CORRECCIONES DE FONDO que trae K5:
+ *
+ * 1) ORDEN + FLUSH. La miga de write_sme de K4 SI va antes de las escrituras,
+ *    pero se queda en el ring buffer. K5 anade, con uke_attach_log>=1, una miga
+ *    POR MAESTRO (dev_name, sid, mask, idx elegido y valores SMR/S2CR que se
+ *    van a escribir) inmediatamente antes de arm_smmu_write_sme(), seguida de
+ *    pr_flush(): la linea tiene que estar en ttyGS0 ANTES del acceso. Si el
+ *    acceso mata, la ultima linea flush-eada es el punto de muerte real.
+ *
+ * 2) SMR(0) NO ES "mask=0x8000". La miga del barrido (K3/K4) decodificaba
+ *    mask=FIELD_GET(ARM_SMMU_SMR_MASK, smr) con el bit 31 (VALID) colado en la
+ *    mascara del campo (ARM_SMMU_SMR_MASK = GENMASK(31,16), arm-smmu.h:102; el
+ *    campo real es 30:16 y mainline lo arregla con "smr &= ~VALID" antes de
+ *    extraer). El valor vivo leido era SMR(0)=0x80000060: valid=1, id=0x60 y
+ *    mask REAL = 0x0000 (no 0x8000). O sea: SMR(0) casa EXACTAMENTE con el sid
+ *    0x60, y el unico maestro del DT con iommus=<&apps_smmu 0x60 0x00> es
+ *    ufshc@1d84000 (stockuke.dts:12589), el UFS del que cuelga el rootfs. El
+ *    mdss (sid 0x1c00, mask 0x02) NO casa con SMR(0): find_sme le da hueco.
+ *
+ * LAGUNA DOCUMENTADA (mitigada en K5): s2crs[] se pobla en el barrido de
+ * qcom_smmu_cfg_probe SIN leer el S2CR real del HW (type=BYPASS/cbndx=0xff
+ * "asumidos"). Con keep_boot=1, s2crs[0] en RAM NO refleja el S2CR(0) del
+ * bootloader: no se sabe si el BL dejo el UFS en BYPASS, en TRANS a un CB con
+ * tablas o en FAULT. K5 lo LEE (lectura; S2CR(109) ya se escribio+leyo en
+ * K2/K3) antes del reset y lo imprime. Solo se leen indices que la RAM marca
+ * como del BL (con uke_smr_max=0, el 0): la lectura de un indice arbitrario NO
+ * esta medida como segura (K2 murio dentro del barrido completo de lecturas).
+ *
+ * PARAMS (solo apps-smmu, reg==0x15000000):
+ *
+ *   uke_attach_log (int, 0 por defecto)
+ *     0 = silencio (comportamiento K4).
+ *     1 = miga por maestro ANTES de escribir (con flush a consola) + volcado
+ *         read-only del estado BL (SMR(0)/S2CR(0) y de cada idx BL-valido)
+ *         antes del reset.
+ *     2 = ademas, si find_sme devuelve un indice que la RAM conoce como VIVO del
+ *         BL (smrs[idx].valid && s2crs[idx].count==0), NO se escribe ese SME:
+ *         se omite write_sme y el maestro queda con el mapeo del BL
+ *         (bypass/traduccion del bootloader). Miga "SME idx=%d PRESERVADO".
+ *
+ *   uke_protect_smr0 (bool, 0 por defecto)
+ *     Variante "reubicar": si el idx elegido es un SME vivo del BL, el maestro
+ *     se reasigna a un indice libre ALTO (de num_mapping_groups-1 hacia abajo,
+ *     primer !smrs[i].valid && s2crs[i].count==0) y se escribe ahi;
+ *     SMR(0)/S2CR(0) del BL no se tocan. Caveat funcional: si el SID ya casaba
+ *     con el SMR vivo, el HW vera DOS SMR que casan el mismo SID (matching
+ *     ambiguo); para la medicina "no tocar nunca lo vivo" sirve, pero no es una
+ *     configuracion fiel. Precedencia: con uke_attach_log>=2, PRESERVAR gana.
+ *
+ * Recordatorio: la deteccion "idx vivo del BL" depende de que el barrido de
+ * qcom_smmu_cfg_probe lo haya dejado en RAM (uke_smr_max>=0). Con
+ * uke_smr_max=-2 (barrido saltado) K5 no conoce ningun indice vivo.
+ */
+static int uke_attach_log;
+static bool uke_protect_smr0;
+
+static int uke_attach_log_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_int(val, kp);
+
+	if (ret)
+		return ret;
+	pr_info("UKE-POKE: uke_attach_log=%d (0=nada; 1=miga por maestro con flush antes de escribir + volcado BL; 2=ademas PRESERVAR los indices vivos del BL sin escribir)\n",
+		uke_attach_log);
+	return 0;
+}
+
+static const struct kernel_param_ops uke_attach_log_ops = {
+	.set	= uke_attach_log_set,
+	.get	= param_get_int,
+};
+
+module_param_cb(uke_attach_log, &uke_attach_log_ops, &uke_attach_log, 0644);
+MODULE_PARM_DESC(uke_attach_log,
+	"UKE (K5): 0=nada; 1=miga por maestro (dev/sid/mask/idx/valores a escribir) con flush ANTES de cada write_sme + volcado del estado BL; 2=ademas no escribe los SME cuyo indice es un mapeo vivo del BL (miga PRESERVADO).");
+
+static int uke_protect_smr0_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (ret)
+		return ret;
+	pr_info("UKE-POKE: uke_protect_smr0=%d: los SME que find_sme mande a un indice vivo del BL se reubican en un indice libre alto; SMR(0)/S2CR(0) no se tocan\n",
+		uke_protect_smr0);
+	return 0;
+}
+
+static const struct kernel_param_ops uke_protect_smr0_ops = {
+	.set	= uke_protect_smr0_set,
+	.get	= param_get_bool,
+};
+
+module_param_cb(uke_protect_smr0, &uke_protect_smr0_ops, &uke_protect_smr0, 0644);
+MODULE_PARM_DESC(uke_protect_smr0,
+	"UKE (K5): 1 = si find_sme elige un indice con smrs[idx].valid del bootloader (vivo), escribe en un indice libre alto en vez de tocar el vivo; 0 (defecto) = comportamiento K4. Solo apps-smmu.");
+
+/*
+ * Bitmap de indices ya preservados por uke_attach_log=2: evita que un segundo
+ * maestro que case el mismo SID vuelva a escribir un indice vivo del BL.
+ * (Con el DT actual el unico sid que casa SMR(0) es 0x60/ufshc, pero la guarda
+ * es barata.) Solo se consulta para el apps-smmu.
+ */
+static DECLARE_BITMAP(uke_preservados_bl, 128);
+
+/* ¿El indice idx es un SME que el barrido dejo vivo y nadie ha reclamado? */
+static bool uke_sme_es_bl(struct arm_smmu_device *smmu, int idx)
+{
+	if (!smmu->smrs || idx < 0 || (unsigned int)idx >= smmu->num_mapping_groups)
+		return false;
+	return smmu->smrs[idx].valid && smmu->s2crs[idx].count == 0;
+}
+
+/* Primer indice libre ALTO (de num_mapping_groups-1 hacia abajo), sin tocar el 0. */
+static int uke_sme_libre_alto(struct arm_smmu_device *smmu)
+{
+	int i;
+
+	if (!smmu->smrs)
+		return -ENOSPC;
+	for (i = (int)smmu->num_mapping_groups - 1; i > 0; i--)
+		if (!smmu->smrs[i].valid && smmu->s2crs[i].count == 0)
+			return i;
+	return -ENOSPC;
+}
+
+/* Valor exacto que arm_smmu_write_smr() escribira (arm-smmu.c:1184-1193). */
+static u32 uke_smr_val(struct arm_smmu_device *smmu, int idx)
+{
+	struct arm_smmu_smr *smr = &smmu->smrs[idx];
+	u32 reg = FIELD_PREP(ARM_SMMU_SMR_ID, smr->id) |
+		  FIELD_PREP(ARM_SMMU_SMR_MASK, smr->mask);
+
+	if (!(smmu->features & ARM_SMMU_FEAT_EXIDS) && smr->valid)
+		reg |= ARM_SMMU_SMR_VALID;
+	return reg;
+}
+
+/* Valor nominal que arm_smmu_write_s2cr() pondria (sin el quirk qcom). */
+static u32 uke_s2cr_val(struct arm_smmu_device *smmu, int idx)
+{
+	struct arm_smmu_s2cr *s2cr = &smmu->s2crs[idx];
+
+	return FIELD_PREP(ARM_SMMU_S2CR_TYPE, s2cr->type) |
+	       FIELD_PREP(ARM_SMMU_S2CR_CBNDX, s2cr->cbndx) |
+	       FIELD_PREP(ARM_SMMU_S2CR_PRIVCFG, s2cr->privcfg);
+}
+
+/*
+ * Decodificacion CORRECTA de la MASK de un SMR leido: el campo es 30:16 y el
+ * bit 31 es VALID; FIELD_GET(ARM_SMMU_SMR_MASK) (GENMASK(31,16)) lo colaba
+ * (K3/K4 imprimieron mask=0x8000 para SMR(0)=0x80000060, cuya mask real es 0).
+ */
+static u32 uke_smr_mask_leido(u32 smr)
+{
+	return FIELD_GET(ARM_SMMU_SMR_MASK, smr & ~ARM_SMMU_SMR_VALID);
+}
+
+/*
+ * Volcado READ-ONLY del estado que dejo el bootloader, antes del reset.
+ * Solo indices BL-validos en RAM (con uke_smr_max=0: el 0); NO se barren SMR
+ * arbitrarios (K2 murio en el barrido completo de LECTURAS).
+ */
+static void uke_dump_bl_state(struct arm_smmu_device *smmu)
+{
+	u32 smr0, s2cr0;
+	int i;
+
+	if (!uke_smmu_es_apps(smmu))
+		return;
+
+	smr0 = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_SMR(0));
+	/*
+	 * UKE-SMMU-CLK (K6, #P13): S2CR(0) NO se lee. La relectura del registro
+	 * de traduccion VIVO del UFS es letal: el disparo K5b (attach_log=1,
+	 * 29-sep 00:55) murio antes del primer print de este volcado, y S2CR(0)
+	 * era la unica lectura no probada del dump. SMR(0) si es seguro (leido
+	 * 4 veces hoy). s2cr0 queda a 0 y la miga imprime la nota NO LEIDO.
+	 */
+	s2cr0 = 0;
+	pr_info("UKE-POKE: BL estado idx=0: SMR(0) HW=0x%08x (valid=%u id=0x%x mask=0x%x) S2CR(0) HW=<NO LEIDO (letal #P13)> (s2cr0=%u)\n",
+		smr0, (unsigned int)FIELD_GET(ARM_SMMU_SMR_VALID, smr0),
+		(unsigned int)FIELD_GET(ARM_SMMU_SMR_ID, smr0),
+		(unsigned int)uke_smr_mask_leido(smr0), s2cr0);
+
+	for (i = 1; smmu->smrs && (unsigned int)i < smmu->num_mapping_groups; i++) {
+		u32 smr, s2cr;
+
+		if (!smmu->smrs[i].valid)	/* solo lo que la RAM conoce del BL */
+			continue;
+		/*
+		 * UKE-SMMU-CLK (K6, #P13): del indice i solo se lee SMR(i).
+		 * S2CR(i) tampoco se lee: es la misma clase de registro de
+		 * traduccion que S2CR(0). Con uke_smr_max=0 este bucle no itera
+		 * (smrs[1..] esta invalid); la nota vale para barridos futuros.
+		 */
+		smr = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_SMR(i));
+		s2cr = 0;
+		pr_info("UKE-POKE: BL estado idx=%d (smrs.valid, count=%u): SMR(%d) HW=0x%08x (valid=%u id=0x%x mask=0x%x) S2CR(%d) HW=<NO LEIDO (letal #P13)> (s2cr=%u)\n",
+			i, smmu->s2crs[i].count, i, smr,
+			(unsigned int)FIELD_GET(ARM_SMMU_SMR_VALID, smr),
+			(unsigned int)FIELD_GET(ARM_SMMU_SMR_ID, smr),
+			(unsigned int)uke_smr_mask_leido(smr), i, s2cr);
+	}
+	pr_flush(500, false);
+}
+
+/*
+ * ==========================================================================
+ * UKE-SMMU-K8 (29-sep-2026): PORT DEL MECANISMO DE HANDOFF (via H de R4).
+ * ==========================================================================
+ *
+ * POR QUE. El mapa de minas medido (#P8-#P23) dice, sin excepcion, una cosa:
+ * el probe del apps-smmu sobrevive a TODO (IDR0/1/2, quirk del bypass, reset
+ * con las fases 4-7) mientras no toque un registro VIVO del bootloader; y
+ * muere (wedge duro, mudo, sin panic) en cuanto LEE el S2CR de un indice vivo
+ * (#P13) o ESCRIBE un SMR/S2CR/CB que el BL tiene en uso (#P14 CB22, #P15
+ * fase3, K4c write_sme idx=1). K7 (armado por cmdline, ventana de 0,4449 s)
+ * murio igual: #P17/#P22/#P23 refutan la hipotesis temporal ⇒ el asesino es
+ * ESTRUCTURAL. La preservacion manual de K4-K7 solo cubria el idx 0
+ * (uke_smr_max=0 deja ciegos los idx 1..109, que find_sme reparte como
+ * "libres" y el attach del storm PISA).
+ *
+ * QUE HACE K8 (diseno consolidado en #P21; codigo de referencia: kernel
+ * Android del SM8635/cliffs lineage-23.0 y CodeLinaro le_kernel_msm-5.15
+ * @8fa3cef, descargado y leido en /var/tmp/uke-k8/ref/):
+ *
+ *   1. BARRIDO DE PINEO (uke_handoff_pin_sweep): tras cfg_probe y ANTES del
+ *      reset, LEE SMR(0..num_mapping_groups-1) (lectura medida segura: #P9 y
+ *      cuatro runs mas leyeron SMR(0) sin morir; la lectura letal es la del
+ *      S2CR, #P13) y marca `s2crs[i].pinned = true` en toda entrada con
+ *      VALID=1. A partir de ahi NINGUN codigo puede escribir ni reasignar ese
+ *      idx: los guards viven en los tres puntos de escritura
+ *      (arm_smmu_write_smr, arm_smmu_write_s2cr y arm_smmu_write_sme), en el
+ *      reparto de indices (arm_smmu_find_sme no reutiliza lo valido) y en el
+ *      liberador (arm_smmu_free_sme), que es el bug ALTA de R1 §7.1
+ *      (arm-smmu.c:1752-1765: arm_smmu_master_free_smes escribia el SME
+ *      liberado SIN guarda ⇒ un unbind del ufshc pisaba S2CR(0)).
+ *
+ *   2. qcom,handoff-smrs DEL DT (uke_handoff_parse_dt): pares <id mask> que el
+ *      DT declara como mapeos del firmware. Nuestro DT efectivo lo trae
+ *      (<0x1c00 0x02>, el SID del mdss/display; verificado #P21 sobre
+ *      /var/tmp/k8-check/merged.dtb). Un maestro cuyo fwpec es subconjunto de
+ *      un par (mismo test que el lineage: ver uke_handoff_es_dt) se PINa y no
+ *      se le escribe ni SMR ni S2CR: el maestro sigue con lo que dejo el BL y
+ *      el dominio queda "sin traducir por ahora" (miga explicita). Es el
+ *      handoff dirigido por DT del vendor, sin necesidad de leer S2CR.
+ *
+ *   3. CB DESDE ARRIBA (uke_alloc_cb_arriba): el lineage reutiliza el CB del
+ *      BL porque puede leer su cbndx del S2CR; aqui ese cbndx es ilegible
+ *      (leerlo mata), asi que los CB de dominios NUEVOS se reservan desde
+ *      num_context_banks-1 hacia abajo (70→0). El BL llena desde abajo (su
+ *      unico SMR visto en 7 runs es el idx 0 = ufshc; #P14 midio su CB vivo en
+ *      el 22), de modo que repartir desde arriba es la mejor aproximacion a
+ *      "no pisar lo vivo" sin poder leerlo. El CB 70 ya lo reserva el quirk
+ *      bypass (set_bit en qcom_smmu_cfg_probe), asi que el primer dominio
+ *      nuevo cae en el 69.
+ *
+ *   4. NUNCA SE LEE S2CR (ni en el barrido ni en el attach): type/privcfg/
+ *      cbndx de un indice pinado quedan DESCONOCIDOS a proposito y ningun
+ *      camino de K8 los necesita, porque de ese idx no se escribe nada.
+ *
+ * QUE NO CAMBIA: la cmdline (uke_smr_max=0, uke_keep_boot=1, uke_attach_log=2,
+ * uke_smmu_probe=1, uke_reset_mask=12), las fases del reset, el arranque
+ * DESARMADO (uke_smmu_probe=0 ⇒ -EPROBE_DEFER antes de tocar nada, identico a
+ * K6/K7) y el comportamiento de cualquier otro SMMU (kgsl): todo K8 esta tras
+ * uke_smmu_es_apps() + uke_handoff.
+ *
+ * PARAMETRO NUEVO `uke_handoff` (solo apps-smmu; default 1):
+ *   0 = APAGADO: todo el codigo K8 se comporta como K7 (A/B limpio).
+ *   1 = COMPLETO (default): barrido de pineo 0..109 + DT + CB desde arriba.
+ *   2 = SIN BARRIDO: no lee NINGUN SMR nuevo; solo pina lo que la RAM ya sabe
+ *       vivo (el barrido acotado de K3 con uke_smr_max) + el DT + CB desde
+ *       arriba. Es la escalera de rescate SIN recompilar: si el barrido
+ *       completo resultase letal en la tablet (K2 murio dentro del barrido de
+ *       LECTURAS y ese punto nunca se aclaro con consola), la siguiente imagen
+ *       es un repack de cmdline con `arm_smmu.uke_handoff=2`.
+ */
+static int uke_handoff = 1;
+
+static int uke_handoff_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_int(val, kp);
+
+	if (ret)
+		return ret;
+	pr_info("UKE-POKE: uke_handoff=%d (solo apps-smmu): 0=APAGADO (comportamiento K7); 1=BARRIDO COMPLETO de SMR vivos + qcom,handoff-smrs del DT + CB desde arriba + nada pinado se escribe; 2=SIN BARRIDO (solo lo que la RAM ya sabe vivo + DT)\n",
+		uke_handoff);
+	return 0;
+}
+
+static const struct kernel_param_ops uke_handoff_ops = {
+	.set	= uke_handoff_set,
+	.get	= param_get_int,
+};
+
+module_param_cb(uke_handoff, &uke_handoff_ops, &uke_handoff, 0644);
+MODULE_PARM_DESC(uke_handoff,
+	"UKE (K8): 0=apagado (K7); 1 (defecto)=handoff completo (barrido de SMR vivos + qcom,handoff-smrs + CB desde arriba); 2=sin barrido de SMR (solo lo que la RAM ya sabe vivo + el DT). Solo apps-smmu (0x15000000).");
+
+/*
+ * PARAMETRO NUEVO `uke_disp_split` (solo apps-smmu, con handoff activo; default 1):
+ *   1 = la banda display (SID 0x1c00/0x1c01) lleva GRUPO PROPIO por dispositivo:
+ *       el dpu hace iommu_attach_device normal (grupo de 1, camino K13 sin
+ *       fallback) y mdss/unsec_cb se quedan en el dominio default, en vez de
+ *       que el fallback attach_group de K13 attach-e el GRUPO ENTERO
+ *       {mdss, dpu, unsec_cb} al dominio paging del KMS.
+ *   0 = comportamiento K13 (fusion por SME compartido + fallback attach_group).
+ */
+static int uke_disp_split = 1;
+module_param(uke_disp_split, int, 0644);
+MODULE_PARM_DESC(uke_disp_split,
+	"UKE (K16): 1 (defecto)=grupos individuales para la banda display (0x1c00/0x1c01); 0=comportamiento K13 (fusion por SME + fallback attach_group).");
+
+/* Pares <id, mask> de qcom,handoff-smrs del DT (el vendor declara 1; 8 sobra). */
+static struct {
+	u16	id;
+	u16	mask;
+} uke_handoff_dt[8];
+static unsigned int uke_handoff_dt_n;
+
+/* ¿Aplica el mecanismo K8 a este SMMU? (solo apps-smmu y con uke_handoff != 0) */
+static bool uke_handoff_activo(struct arm_smmu_device *smmu)
+{
+	return uke_handoff != 0 && smmu->dev && smmu->dev->of_node &&
+	       uke_smmu_es_apps(smmu);
+}
+
+/* ¿Este idx es un mapeo del firmware que NUNCA se puede escribir ni liberar? */
+static bool uke_pinado(struct arm_smmu_device *smmu, int idx)
+{
+	if (!uke_handoff_activo(smmu))
+		return false;
+	if (idx < 0 || (unsigned int)idx >= smmu->num_mapping_groups)
+		return false;
+	return smmu->s2crs[idx].pinned;
+}
+
+/*
+ * Test de subconjunto del vendor (literal de arm_smmu_handoff_cbs(),
+ * ref/xiaomi-arm-smmu.c:3082-3083 y commit CodeLinaro 8fa3cef "arm-smmu: use
+ * smr match for handoff-smrs"): un SMR/fwpec es "handoff" si TODO lo que exige
+ * cabe dentro del par declarado en el DT.
+ *   (hand.mask & x.mask) == x.mask   -> la mascara del DT cubre la del SMR
+ *   !((hand.id ^ x.id) & ~hand.mask) -> los bits fijos del ID coinciden
+ * El commit cambio de comparar por INDICE de SMR a comparar por id/mask
+ * justamente porque el indice "could mismatch between ABL and HLOS".
+ */
+static bool uke_handoff_es_dt(u16 id, u16 mask)
+{
+	unsigned int i;
+
+	for (i = 0; i < uke_handoff_dt_n; i++) {
+		u16 hid = uke_handoff_dt[i].id;
+		u16 hmask = uke_handoff_dt[i].mask;
+
+		if ((hmask & mask) == mask && !((hid ^ id) & ~hmask))
+			return true;
+	}
+	return false;
+}
+
+static void uke_handoff_parse_dt(struct arm_smmu_device *smmu)
+{
+	struct device_node *np = smmu->dev->of_node;
+	u32 id, mask;
+	int n, i;
+
+	uke_handoff_dt_n = 0;
+	if (!np)
+		return;
+
+	n = of_property_count_elems_of_size(np, "qcom,handoff-smrs",
+					    sizeof(u32) * 2);
+	if (n <= 0) {
+		pr_info("UKE-POKE: handoff: DT sin qcom,handoff-smrs (o mal formada): 0 pares; el pineo queda solo en manos del barrido\n");
+		return;
+	}
+	if (n > (int)ARRAY_SIZE(uke_handoff_dt))
+		n = (int)ARRAY_SIZE(uke_handoff_dt);
+
+	for (i = 0; i < n; i++) {
+		if (of_property_read_u32_index(np, "qcom,handoff-smrs", 2 * i, &id) ||
+		    of_property_read_u32_index(np, "qcom,handoff-smrs", 2 * i + 1, &mask)) {
+			pr_warn("UKE-POKE: handoff: no se pudo leer el par %d de qcom,handoff-smrs; se corta\n",
+				i);
+			break;
+		}
+		uke_handoff_dt[i].id = (u16)id;
+		uke_handoff_dt[i].mask = (u16)mask;
+		uke_handoff_dt_n = i + 1;
+		pr_info("UKE-POKE: handoff: DT qcom,handoff-smrs[%u] = <0x%x 0x%x>: ese SID/mask es del BL y no se escribira\n",
+			uke_handoff_dt_n - 1, id, mask);
+	}
+}
+
+/*
+ * BARRIDO DE PINEO. Es el corazon de K8 y la unica lectura nueva que hace:
+ * SMR(0..num_mapping_groups-1) con una miga por cada entrada VIVA (las
+ * decisiones) y una miga de progreso cada 16 indices (para poder localizar un
+ * atasco blando, como el de #P10, si lo hubiera).
+ *
+ * Lo que NO se hace: leer S2CR (letal #P13), escribir nada, ni tocar
+ * smmu->smrs[]/s2crs[] mas alla del bit `pinned` (la copia RAM del SMR se deja
+ * tal cual, que es la del BL).
+ */
+static void uke_handoff_pin_sweep(struct arm_smmu_device *smmu)
+{
+	unsigned int n_pin = 0, n_leidos = 0;
+	int i;
+
+	if (!smmu->smrs) {
+		pr_info("UKE-POKE: handoff: smrs==NULL (stream indexing forzado): sin banco de SMR que pinear; solo actuara el DT y el CB desde arriba\n");
+		return;
+	}
+
+	if (uke_handoff >= 2) {
+		for (i = 0; i < (int)smmu->num_mapping_groups; i++) {
+			if (!smmu->smrs[i].valid)
+				continue;
+			smmu->s2crs[i].pinned = true;
+			n_pin++;
+			pr_info("UKE-POKE: handoff: PIN SMR(%d) id=0x%x mask=0x%x (vivo segun la RAM; modo 2 SIN barrido) -> idx NO ESCRIBIBLE\n",
+				i, smmu->smrs[i].id, smmu->smrs[i].mask);
+		}
+		pr_info("UKE-POKE: handoff: modo 2 (sin barrido): PINADOS=%u de %u grupos; no se leyo ningun SMR nuevo\n",
+			n_pin, smmu->num_mapping_groups);
+		pr_flush(500, false);
+		return;
+	}
+
+	pr_info("UKE-POKE: handoff: INICIO barrido de pineo SMR(0..%u) (%u grupos). Solo LECTURAS de SMR (medidas seguras, #P9); el S2CR de un indice vivo NO se lee (letal #P13)\n",
+		smmu->num_mapping_groups - 1, smmu->num_mapping_groups);
+	for (i = 0; i < (int)smmu->num_mapping_groups; i++) {
+		u32 smr;
+
+		if (!(i & 15))
+			pr_info("UKE-POKE: handoff: barrido SMR %d/%u ...\n",
+				i, smmu->num_mapping_groups);
+		smr = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_SMR(i));
+		n_leidos++;
+		if (!FIELD_GET(ARM_SMMU_SMR_VALID, smr))
+			continue;
+
+		smmu->s2crs[i].pinned = true;
+		n_pin++;
+		pr_info("UKE-POKE: handoff: PIN SMR(%d) HW=0x%08x id=0x%x mask=0x%x%s -> idx %d NO ESCRIBIBLE (ni SMR ni S2CR ni CB)\n",
+			i, smr, (unsigned int)FIELD_GET(ARM_SMMU_SMR_ID, smr),
+			(unsigned int)uke_smr_mask_leido(smr),
+			uke_handoff_es_dt((u16)FIELD_GET(ARM_SMMU_SMR_ID, smr),
+					  (u16)uke_smr_mask_leido(smr)) ?
+				" [declarado en qcom,handoff-smrs]" : " [vivo del BL]",
+			i);
+	}
+	pr_info("UKE-POKE: handoff: FIN barrido: leidos=%u PINADOS=%u (%u grupos). Desde aqui ni el reset ni el attach escriben esos indices\n",
+		n_leidos, n_pin, smmu->num_mapping_groups);
+	pr_flush(500, false);
+}
+
+static void uke_handoff_preparar(struct arm_smmu_device *smmu)
+{
+	if (!uke_handoff_activo(smmu))
+		return;
+	pr_info("UKE-POKE: handoff: PREPARAR modo=%d smrs=%s grupos=%u CBs=%u (K8: nada pinado se escribe; los CB nuevos se reparten desde arriba)\n",
+		uke_handoff, smmu->smrs ? "si" : "NULL",
+		smmu->num_mapping_groups, smmu->num_context_banks);
+	uke_handoff_parse_dt(smmu);
+	uke_handoff_pin_sweep(smmu);
+}
+
+/*
+ * ==========================================================================
+ * UKE-SMMU-K9 (29-sep-2026): MASCARA DE ESCRITURAS + MIGAS DELANTE DE CADA
+ * ESCRITURA DEL CAMINO ARMADO (respuesta a los huecos H1/H2/H4/H7 de C2).
+ * ==========================================================================
+ *
+ * POR QUE. K8 (pineo de SMR vivos + qcom,handoff-smrs + CB desde arriba)
+ * murio MUDO a los 0,44 s (#P25), igual que K7. La critica C2 establecio que
+ * una muerte muda NO incrimina al barrido de LECTURAS (las lecturas de SMR
+ * estan medidas seguras x5: #P9 y cuatro runs mas) y que los sospechosos sin
+ * medir a 0,44 s son las ESCRITURAS que K8 deja armadas:
+ *   - F4 TLBIALLH/TLBIALLNSNH (globales),
+ *   - F5 RMW/calculo de sCR0 y F7 tlb_sync_global + write sCR0 (el paso
+ *     CLIENTPD 1->0 es exactamente "encender" la SMMU heredada del BL),
+ *   - F6 (arm_mmu500_reset: RMW de sACR + CB_ACTLR x71 del CPRE_ERRATA),
+ *   - el quirk qcom (S2CR(109) + CB70/CBAR(70), que corre ANTES del barrido),
+ *   - arm_smmu_rmr_install_bypass_smr (sCR0 |= CLIENTPD),
+ *   - y las escrituras del attach (write_sme / install_s2cr /
+ *     write_context_bank del primer dominio traducido).
+ *
+ * QUE HACE K9 (minimo sobre K8; NADA de esto corre en el arranque desarmado):
+ *
+ *   1. uke_write_mask: mascara de GRUPOS de escritura del camino armado.
+ *      bit a 1 = el grupo SE EJECUTA; bit a 0 = el grupo se SILENCIA con miga
+ *      (UKE-POKE + pr_flush) y el registro NO se toca. Default 0 = SILENCIO
+ *      TOTAL (rung 0 de la escalera). 0xfff = alias de "todo" (== 0x1ff).
+ *      Con UNA sola imagen se recorre toda la escalera por cmdline:
+ *        mask=0  -> si AUN muere mudo, el asesino es de LECTURA o del resto
+ *                   incondicional (F1 sGFSR, el barrido, los IDR, la
+ *                   relectura del quirk si no se silencia); si VIVE, el
+ *                   asesino es una de estas escrituras y se van reactivando
+ *                   grupos poniendo bits (uno a uno o por bloques).
+ *        mask=0x1ff (o 0xfff) -> K8 con migas: todo habilitado.
+ *
+ *   2. Migas delante de CADA escritura del camino armado con pr_flush: F4,
+ *      F6 (sACR + muestras CB0/CB22/CB70 del bucle CB_ACTLR), F5/F7 sCR0
+ *      (con el valor leido y el calculado), quirk (S2CR(109)/CB70/CBAR70),
+ *      rmr (CLIENTPD), y cada write_sme/install_s2cr/write_context_bank del
+ *      attach. Con el sistema vivo (>=3,57 s) o en un re-bind por sysfs esas
+ *      lineas quedan en el anillo y dicen el punto exacto; en una muerte muda
+ *      temprana no hay consola, pero entonces la informacion la da la propia
+ *      mascara (que es el instrumento que sobrevive: silencio vs vida).
+ *
+ *   3. Guardas de CB (C2 H2): el CB num_context_banks-1 (70, el del bypass
+ *      del quirk/BL) NO se escribe por NINGUN camino mientras el apps-smmu
+ *      este armado; y un write_context_bank con cfg (CB de un dominio NUEVO)
+ *      solo se programa si su indice salio del reparto DESDE ARRIBA
+ *      (uke_alloc_cb_arriba). Ambas guardas imprimen el indice.
+ *
+ * ANTI-REGRESION: uke_wmask_activo() exige uke_smmu_armado (el mismo bool del
+ * gate del probe) + apps-smmu. Con el arranque normal (sin token) nada de K9
+ * se ejecuta; con uke_smmu_probe=0 tampoco. El resto del driver (kgsl) no ve
+ * ni una linea.
+ */
+static int uke_write_mask;
+
+static int uke_write_mask_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_int(val, kp);
+
+	if (ret)
+		return ret;
+	pr_info("UKE-POKE: uke_write_mask=0x%x (efectivo 0x%x; bit a 1 = el grupo SE EJECUTA, bit a 0 = se SILENCIA con miga; 0x0 = SILENCIO TOTAL, 0xfff = todo): F4_TLBI=%u F5_sCR0=%u F6_ACTLR=%u F7_sCR0=%u quirk=%u rmr_CLIENTPD=%u attach_sme=%u install_s2cr=%u ctxbank=%u\n",
+		(unsigned int)uke_write_mask,
+		(unsigned int)(uke_write_mask & UKE_WMASK_BITS),
+		!!(uke_write_mask & UKE_WMASK_F4_TLBI),
+		!!(uke_write_mask & UKE_WMASK_F5_SCR0),
+		!!(uke_write_mask & UKE_WMASK_F6_ACTLR),
+		!!(uke_write_mask & UKE_WMASK_F7_SCR0),
+		!!(uke_write_mask & UKE_WMASK_QUIRK),
+		!!(uke_write_mask & UKE_WMASK_RMR),
+		!!(uke_write_mask & UKE_WMASK_ATT_SME),
+		!!(uke_write_mask & UKE_WMASK_INST_S2CR),
+		!!(uke_write_mask & UKE_WMASK_CTXBANK));
+	return 0;
+}
+
+static const struct kernel_param_ops uke_write_mask_ops = {
+	.set	= uke_write_mask_set,
+	.get	= param_get_int,
+};
+
+module_param_cb(uke_write_mask, &uke_write_mask_ops, &uke_write_mask, 0644);
+MODULE_PARM_DESC(uke_write_mask,
+	"UKE (K9): mascara de GRUPOS de escritura del probe armado del apps-smmu: bit0=F4 TLBIALLH/NSNH, bit1=F5 sCR0 (leer+calcular), bit2=F6 sACR+CB_ACTLR x71, bit3=F7 tlb_sync+sCR0, bit4=quirk S2CR(109)/CB70/CBAR70, bit5=rmr sCR0|=CLIENTPD, bit6=attach write_sme nuevos, bit7=attach install_s2cr, bit8=write_context_bank nuevos. bit a 1 = EJECUTAR; bit a 0 = SILENCIAR con miga. Default 0 (silencio total); 0xfff = todo.");
+
+/* ¿Esta activo el instrumento K9 para este SMMU? (solo el probe armado del apps-smmu) */
+bool uke_wmask_activo(struct arm_smmu_device *smmu)
+{
+	return uke_smmu_armado && smmu->dev && smmu->dev->of_node &&
+	       uke_smmu_es_apps(smmu);
+}
+
+/*
+ * ¿Se ejecuta este grupo de escritura? Fuera del experimento armado devuelve
+ * true (comportamiento mainline intacto, y K8 nunca cambia por K9).
+ */
+bool uke_wmask_on(struct arm_smmu_device *smmu, u32 bit)
+{
+	if (!uke_wmask_activo(smmu))
+		return true;
+	return (uke_write_mask & bit) != 0;
+}
+
+/* Valor efectivo de la mascara (bits 0..8) para las migas de otros ficheros. */
+u32 uke_wmask_valor(void)
+{
