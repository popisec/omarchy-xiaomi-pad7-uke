  * Backlight driver for the Kinetic KTZ8866
  *
  * Copyright (C) 2022, 2023 Jianhua Lu <lujianhua000@gmail.com>
+ *
+ * UKE port (Xiaomi Pad 7 "uke", SM7675): vendor behavior grafted from
+ * msm_drm.ko (stock vendor, RE 2026-10-13). The vendor driver lives
+ * entirely inside msm_drm.ko (no backlight class device, no DT props):
+ *
+ * - DT (stock dtbo, fragments 105/106): one ktz8866@11 node per QUP
+ *   (qupv3_se0_i2c + qupv3_se12_i2c), compatible "ktz,ktz8866", reg <0x11>.
+ *   The uke panel (mi,panel-id 0x4f3832/0x5042020b = ID 0x14) declares
+ *   qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_external", so brightness
+ *   NEVER goes through DCS 0x51 on this panel; dsi_panel_set_backlight()
+ *   case 3 calls ktz8866_backlight_update_status() instead
+ *   (msm_drm.ko .text+0x18e1c4).
+ * - I2C: single-byte reg + single-byte value (regmap reg_bits=8,
+ *   val_bits=8, all other regmap_config fields 0; .rodata+0x98d20).
+ *   probe requires I2C_FUNC_SMBUS_BYTE_DATA on the adapter (mask 0x180000
+ *   at .text+0x18e3e0; the vendor error string says "SMBUS_BYTE" but the
+ *   mask is BYTE_DATA) and performs NO register I/O (no chip-ID read).
+ * - Registers written (regmap_write, .text+0x18e4f4 ktz_update_status):
+ *     0x08 <- 0x7F when level != 0 and previously off (enable),
+ *     0x08 <- 0x3F when level == 0 (disable, sinks stay on),
+ *     0x04 <- level & 0x7   (brightness LSB, bits 2:0),
+ *     0x05 <- (level >> 3) & 0xFF (brightness MSB, bits 10:3).
+ *   i.e. an 11-bit brightness in {0x04[2:0], 0x05[7:0]}, range 0..0x7FF.
+ * - Brightness curve (.text+0x18e1c4): 12-bit input 0..0xFFF, rejected
+ *   with -EINVAL above 0xFFF ("ktz8866 backlight out of 4095 too large!!!").
+ *   Two-segment index into mi_bl_level_remap[2048] (.rodata+0x96d20):
+ *     level < 0x800 : idx = level * 0x5FF / 0x7FF
+ *     level >= 0x800: idx = (level * 0x200 - 0x100000) / 0x7FF + 0x5FF
+ *   (continuous at the 0x800 knee: both give idx 0x5FF). If the remapped
+ *   value exceeds 0x7FF the write is skipped (dead code with the stock
+ *   table, whose max is 0x7FF; kept for fidelity).
+ * - The vendor keeps a global list of probed chips and writes ALL of them
+ *   on every update (dual backlight: two chips, one per I2C bus). There is
+ *   no per-chip backlight device; ktz_get_brightness() (.text+0x18e680) has
+ *   no in-module caller (only reachable through ops[1], never invoked) and
+ *   its compiled body calls regmap_read() without setting the reg/val
+ *   arguments, so it is treated as dead code here and get_brightness
+ *   returns the last written level instead.
+ * - probe allocates 40 bytes per chip {u32 level; u8 enabled; regmap *;
+ *   list_head; ops *} and links it into ktz8866_dev_list under
+ *   ktz8866_dev_list_mutex; remove() is an empty ret.
+ * - Delays: none inside probe/update/remove. The 6 ms sleep
+ *   (usleep_range_state(6000, 6010) at .text+0x14e374) lives in the
+ *   DSI panel driver blank path after DSI cmd-set 0xfc, not in ktz code.
  */
 
 #include <linux/backlight.h>
@@ -13,8 +57,10 @@
 #include <linux/of.h>
 #include <linux/regmap.h>
 
-#define DEFAULT_BRIGHTNESS 1500
-#define MAX_BRIGHTNESS 2047
+/* Vendor: qcom,mdss-dsi-bl-max-level = <0xfff> (12-bit input range). */
+#define MAX_BRIGHTNESS 4095
+/* Vendor: qcom,mdss-brightness-init-level = <0x133> (stock dtbo frag@95). */
+#define DEFAULT_BRIGHTNESS 0x133
 #define REG_MAX 0x15
 
 /* reg */
@@ -40,6 +86,9 @@
 
 /* definition */
