+/* Vendor full-byte BL_EN values (sinks 5:0 forced on, bit 6 = enable). */
+#define BL_EN_ON 0x7F
+#define BL_EN_OFF 0x3F
 #define LCD_BIAS_EN 0x9F
 #define PWM_HYST 0x5
 
