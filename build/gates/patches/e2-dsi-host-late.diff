+/*
+ * UKE-E2 (11-oct-2026): experimento E2 del informe del panel ("El enigma del
+ * panel: INFORME CERRADO", ESTADO-VIVO.md). Orden mainline del enable:
+ * dsi_mgr_bridge_pre_enable() -> dsi_mgr_bridge_power_on() [phy enable:
+ * dsi_manager.c:224 via dsi_mgr_phy_enable; host power_on: :228; irq: :248]
+ * -> msm_dsi_host_enable() (:300, host1 :307) -> y DESPUES corre el
+ * pre_enable del panel-bridge (o82_prepare: supplies + reset + init DCS).
+ * Es decir, el reset del panel ocurre con el host/PHY ya habilitados y el
+ * motor de video ARRANCADO. En Android/ABL el enable en frio corre con el
+ * host del kernel todavia muerto (carriles LP11). E2 (uke_dsi_host_late=1)
+ * aplaza SOLO el msm_dsi_host_enable() (dsi_op_mode_config: VID_MODE_EN/
+ * CMD_MODE_EN, el arranque del motor de video) al .enable del puente DSI
+ * (dsi_mgr_bridge_enable), que el core DRM ejecuta tras el pre_enable del
+ * panel-bridge (drm_atomic_helper_commit_modeset_enables: crtc ->
+ * pre_enables de la cadena -> encoder commit -> bridge enables). El init
+ * DCS del panel NO necesita host_enable: necesita el power_on (relojes de
+ * link + DSI_CTRL_ENABLE, carriles en LP-11); los writes van por el motor
+ * de comandos DMA (msm_dsi_host_cmd_tx), igual que hoy. 0 (defecto) = orden
+ * mainline intacto. Param del modulo msm: msm.uke_dsi_host_late=1 (bool,
+ * 0444: solo decide en el arranque).
+ */
+static bool uke_dsi_host_late;
+module_param(uke_dsi_host_late, bool, 0444);
+MODULE_PARM_DESC(uke_dsi_host_late,
+	"UKE (E2): 0 (defecto)=host_enable en pre_enable (orden mainline); 1=aplazar host_enable hasta despues del prepare del panel (reset del panel con carriles LP-11 y motor de video apagado).");
+
+/* UKE-E2: aplazamiento pendiente entre el pre_enable y el enable del mismo
+ * commit de modeset. */
+static bool uke_host_en_pending;
+
