+/* UKE-E2 (uke_dsi_host_late=1): segundo tramo del aplazamiento. El core
+ * DRM llama a los .enable del puente DESPUES de todos los .pre_enable de
+ * la cadena (drm_atomic_helper_commit_encoder_bridge_enable), o sea, tras
+ * el o82_prepare completo (reset + init DCS + sleep-out + display-on).
+ * Aqui se sube de verdad el motor de video (dsi_op_mode_config ->
+ * VID_MODE_EN). Con el param a 0 esta funcion no hace nada: el enable ya
+ * corrio en pre_enable (orden mainline). El disable inverso no cambia:
+ * dsi_mgr_bridge_post_disable sigue haciendo host_disable -> irq ->
+ * power_off -> phy_disable, simetrico con ambos ordenes y sin fugas
+ * (msm_dsi_host_enable no retiene recursos propios; si fallara, el
+ * pr_err deja constancia y el post_disable apaga igual).
+ */
+static void dsi_mgr_bridge_enable(struct drm_bridge *bridge)
+{
+	int id = dsi_mgr_bridge_get_id(bridge);
+	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
+	struct msm_dsi *msm_dsi1 = dsi_mgr_get_dsi(DSI_1);
+	struct mipi_dsi_host *host = msm_dsi->host;
+	bool is_bonded_dsi = IS_BONDED_DSI();
+
+	DBG("id=%d", id);
+
+	/* Espejo del guard de pre_enable: en bonded el puente esclavo no
+	 * lleva hosts propios.
+	 */
+	if (is_bonded_dsi && !IS_MASTER_DSI_LINK(id))
+		return;
+
+	/* Solo hay trabajo si pre_enable aplazo el enable (param=1); el
+	 * flag evita un doble enable si el core llamara a .enable sin
+	 * pre_enable previo.
+	 */
+	if (!uke_host_en_pending)
+		return;
+	uke_host_en_pending = false;
+
+	if (msm_dsi_host_enable(host))
+		pr_err("%s: enable host %d failed\n", __func__, id);
+
+	if (is_bonded_dsi && msm_dsi1) {
+		if (msm_dsi_host_enable(msm_dsi1->host))
+			pr_err("%s: enable host1 failed\n", __func__);
+	}
+}
