 /*
+ * ==========================================================================
+ * UKE-SMMU-K9 (29-sep-2026): MASCARA DE ESCRITURAS + MIGAS DELANTE DE CADA
+ * ESCRITURA DEL CAMINO ARMADO (respuesta a los huecos H1/H2/H4/H7 de C2).
+ * ==========================================================================
+ *
+ * POR QUE. K8 (pineo de SMR vivos + qcom,handoff-smrs + CB desde arriba)
+ * murio MUDO a los 0,44 s (#P25), igual que K7. La critica C2 establecio que
+ * una muerte muda NO incrimina al barrido de LECTURAS (las lecturas de SMR
+ * estan medidas seguras x5: #P9 y cuatro runs mas) y que los sospechosos sin
+ * medir a 0,44 s son las ESCRITURAS que K8 deja armadas:
+ *   - F4 TLBIALLH/TLBIALLNSNH (globales),
+ *   - F5 RMW/calculo de sCR0 y F7 tlb_sync_global + write sCR0 (el paso
+ *     CLIENTPD 1->0 es exactamente "encender" la SMMU heredada del BL),
+ *   - F6 (arm_mmu500_reset: RMW de sACR + CB_ACTLR x71 del CPRE_ERRATA),
+ *   - el quirk qcom (S2CR(109) + CB70/CBAR(70), que corre ANTES del barrido),
+ *   - arm_smmu_rmr_install_bypass_smr (sCR0 |= CLIENTPD),
+ *   - y las escrituras del attach (write_sme / install_s2cr /
+ *     write_context_bank del primer dominio traducido).
+ *
+ * QUE HACE K9 (minimo sobre K8; NADA de esto corre en el arranque desarmado):
+ *
+ *   1. uke_write_mask: mascara de GRUPOS de escritura del camino armado.
+ *      bit a 1 = el grupo SE EJECUTA; bit a 0 = el grupo se SILENCIA con miga
+ *      (UKE-POKE + pr_flush) y el registro NO se toca. Default 0 = SILENCIO
+ *      TOTAL (rung 0 de la escalera). 0xfff = alias de "todo" (== 0x1ff).
+ *      Con UNA sola imagen se recorre toda la escalera por cmdline:
+ *        mask=0  -> si AUN muere mudo, el asesino es de LECTURA o del resto
+ *                   incondicional (F1 sGFSR, el barrido, los IDR, la
+ *                   relectura del quirk si no se silencia); si VIVE, el
+ *                   asesino es una de estas escrituras y se van reactivando
+ *                   grupos poniendo bits (uno a uno o por bloques).
+ *        mask=0x1ff (o 0xfff) -> K8 con migas: todo habilitado.
+ *
+ *   2. Migas delante de CADA escritura del camino armado con pr_flush: F4,
+ *      F6 (sACR + muestras CB0/CB22/CB70 del bucle CB_ACTLR), F5/F7 sCR0
+ *      (con el valor leido y el calculado), quirk (S2CR(109)/CB70/CBAR70),
+ *      rmr (CLIENTPD), y cada write_sme/install_s2cr/write_context_bank del
+ *      attach. Con el sistema vivo (>=3,57 s) o en un re-bind por sysfs esas
+ *      lineas quedan en el anillo y dicen el punto exacto; en una muerte muda
+ *      temprana no hay consola, pero entonces la informacion la da la propia
+ *      mascara (que es el instrumento que sobrevive: silencio vs vida).
+ *
+ *   3. Guardas de CB (C2 H2): el CB num_context_banks-1 (70, el del bypass
+ *      del quirk/BL) NO se escribe por NINGUN camino mientras el apps-smmu
+ *      este armado; y un write_context_bank con cfg (CB de un dominio NUEVO)
+ *      solo se programa si su indice salio del reparto DESDE ARRIBA
+ *      (uke_alloc_cb_arriba). Ambas guardas imprimen el indice.
+ *
+ * ANTI-REGRESION: uke_wmask_activo() exige uke_smmu_armado (el mismo bool del
+ * gate del probe) + apps-smmu. Con el arranque normal (sin token) nada de K9
+ * se ejecuta; con uke_smmu_probe=0 tampoco. El resto del driver (kgsl) no ve
+ * ni una linea.
+ */
+static int uke_write_mask;
+
+static int uke_write_mask_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_int(val, kp);
+
+	if (ret)
+		return ret;
+	pr_info("UKE-POKE: uke_write_mask=0x%x (efectivo 0x%x; bit a 1 = el grupo SE EJECUTA, bit a 0 = se SILENCIA con miga; 0x0 = SILENCIO TOTAL, 0xfff = todo): F4_TLBI=%u F5_sCR0=%u F6_ACTLR=%u F7_sCR0=%u quirk=%u rmr_CLIENTPD=%u attach_sme=%u install_s2cr=%u ctxbank=%u\n",
+		(unsigned int)uke_write_mask,
+		(unsigned int)(uke_write_mask & UKE_WMASK_BITS),
+		!!(uke_write_mask & UKE_WMASK_F4_TLBI),
+		!!(uke_write_mask & UKE_WMASK_F5_SCR0),
+		!!(uke_write_mask & UKE_WMASK_F6_ACTLR),
+		!!(uke_write_mask & UKE_WMASK_F7_SCR0),
+		!!(uke_write_mask & UKE_WMASK_QUIRK),
+		!!(uke_write_mask & UKE_WMASK_RMR),
+		!!(uke_write_mask & UKE_WMASK_ATT_SME),
+		!!(uke_write_mask & UKE_WMASK_INST_S2CR),
+		!!(uke_write_mask & UKE_WMASK_CTXBANK));
+	return 0;
+}
+
+static const struct kernel_param_ops uke_write_mask_ops = {
+	.set	= uke_write_mask_set,
+	.get	= param_get_int,
+};
+
+module_param_cb(uke_write_mask, &uke_write_mask_ops, &uke_write_mask, 0644);
+MODULE_PARM_DESC(uke_write_mask,
+	"UKE (K9): mascara de GRUPOS de escritura del probe armado del apps-smmu: bit0=F4 TLBIALLH/NSNH, bit1=F5 sCR0 (leer+calcular), bit2=F6 sACR+CB_ACTLR x71, bit3=F7 tlb_sync+sCR0, bit4=quirk S2CR(109)/CB70/CBAR70, bit5=rmr sCR0|=CLIENTPD, bit6=attach write_sme nuevos, bit7=attach install_s2cr, bit8=write_context_bank nuevos. bit a 1 = EJECUTAR; bit a 0 = SILENCIAR con miga. Default 0 (silencio total); 0xfff = todo.");
+
+/* ¿Esta activo el instrumento K9 para este SMMU? (solo el probe armado del apps-smmu) */
+bool uke_wmask_activo(struct arm_smmu_device *smmu)
+{
+	return uke_smmu_armado && smmu->dev && smmu->dev->of_node &&
+	       uke_smmu_es_apps(smmu);
+}
+
+/*
+ * ¿Se ejecuta este grupo de escritura? Fuera del experimento armado devuelve
+ * true (comportamiento mainline intacto, y K8 nunca cambia por K9).
+ */
+bool uke_wmask_on(struct arm_smmu_device *smmu, u32 bit)
+{
+	if (!uke_wmask_activo(smmu))
+		return true;
+	return (uke_write_mask & bit) != 0;
+}
+
+/* Valor efectivo de la mascara (bits 0..8) para las migas de otros ficheros. */
+u32 uke_wmask_valor(void)
+{
+	return (u32)(uke_write_mask & UKE_WMASK_BITS);
+}
+
+/*
+ * Migas y vasos de K9: SOLO cuando el experimento armado esta activo (apps-smmu
+ * + uke_smmu_probe=1). Fuera de ahi no imprimen ni flushean nada, para que el
+ * arranque normal y el kgsl-smmu no vean ni una linea nueva (anti-regresion).
+ */
+#define UKE_K9_LOG(...)		do { if (uke_wmask_activo(smmu)) pr_info(__VA_ARGS__); } while (0)
+#define UKE_K9_FLUSH()		do { if (uke_wmask_activo(smmu)) pr_flush(500, false); } while (0)
+
+/*
+ * Bitmap de los CB que ha repartido uke_alloc_cb_arriba: la guarda de
+ * write_context_bank (C2 H2) solo deja programar un CB con cfg si su indice
+ * salio de este reparto. Se indexa por indice de CB (71 como maximo aqui).
+ */
+static DECLARE_BITMAP(uke_cb_reservados_arriba, 128);
+
+static void uke_cb_arriba_marcar(int idx)
+{
+	if ((unsigned int)idx < 128)
+		set_bit(idx, uke_cb_reservados_arriba);
+}
+
+static bool uke_cb_arriba_esta(int idx)
+{
+	return (unsigned int)idx < 128 && test_bit(idx, uke_cb_reservados_arriba);
+}
+
+/* Migas del instrumento con el estado de la mascara (una linea por decision). */
+static void uke_wmask_preparar(struct arm_smmu_device *smmu)
+{
+	if (!uke_wmask_activo(smmu))
+		return;
+	pr_info("UKE-POKE: K9 uke_write_mask=0x%x (efectivo 0x%x): F4_TLBI=%u F5_sCR0=%u F6_ACTLR=%u F7_sCR0=%u quirk=%u rmr_CLIENTPD=%u attach_sme=%u install_s2cr=%u ctxbank=%u  [0x0 = cero escrituras nuevas: si aun muere mudo, el asesino es de LECTURA/resto incondicional; si vive, se reactivan grupos]\n",
+		(unsigned int)uke_write_mask,
+		(unsigned int)(uke_write_mask & UKE_WMASK_BITS),
+		!!(uke_write_mask & UKE_WMASK_F4_TLBI),
+		!!(uke_write_mask & UKE_WMASK_F5_SCR0),
+		!!(uke_write_mask & UKE_WMASK_F6_ACTLR),
+		!!(uke_write_mask & UKE_WMASK_F7_SCR0),
+		!!(uke_write_mask & UKE_WMASK_QUIRK),
+		!!(uke_write_mask & UKE_WMASK_RMR),
+		!!(uke_write_mask & UKE_WMASK_ATT_SME),
+		!!(uke_write_mask & UKE_WMASK_INST_S2CR),
+		!!(uke_write_mask & UKE_WMASK_CTXBANK));
+	pr_flush(500, false);
+}
