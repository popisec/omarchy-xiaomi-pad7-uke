+/*
+ * UKE-P82-INHERIT (L22): herencia cont_splash estilo vendor. Con =1 el panel
+ * LLEGA ENCENDIDO del ABL (el dueno VE el splash y el log en el LCD y muere
+ * despues): el driver del panel no pone rieles, no aserta reset, no envia
+ * init-DCS, y el DPU no reescribe el vbif sobre el scanout andando. Ver
+ * docs/historia/revision/PANEL-INHERIT-20261012.md.
+ */
+static bool uke_panel_inherit_val;
+module_param_named(uke_panel_inherit, uke_panel_inherit_val, bool, 0644);
+MODULE_PARM_DESC(uke_panel_inherit,
+		 "panel heredado encendido del ABL: no tocar rieles/reset/init-DCS del panel ni vbif del DPU");
+bool uke_panel_inherit(void)
+{
+	return uke_panel_inherit_val;
+}
+EXPORT_SYMBOL_GPL(uke_panel_inherit);
