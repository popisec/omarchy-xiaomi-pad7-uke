@@ -1637,17 +1641,37 @@
 	struct msm_dsi_host *msm_host =
 		container_of(work, struct msm_dsi_host, err_work);
 	u32 status = msm_host->err_work_state;
+	bool braked;
+
+	/*
+	 * L73-B2A (15-oct): el vendor cuenta eventos con ventana de 250 ms
+	 * (dsi_ctrl_isr, umbral 0x10) y al superarlos DEJA de re-armar la IRQ
+	 * de error. El re-arm incondicional de abajo, con una condicion
+	 * latcheada (toggle L68 -> FIFO 0xdddd1011), era un bucle de nivel
+	 * infinito: 143k lineas/20 s (L71). Ventana nueva cada 250 ms
+	 * re-habilita la deteccion (autorecuperable).
+	 */
+	if (time_after(jiffies,
+		       msm_host->err_win_start + msecs_to_jiffies(250))) {
+		msm_host->err_win_start = jiffies;
+		msm_host->err_win_count = 0;
+	}
+	braked = ++msm_host->err_win_count > 16;
+	if (braked)
