+				   msm_host->id, msm_host->err_win_count);
 
 	/* S4-DIAG (arranque): atribuir el rafaga a su link en dual-DSI. */
 	pr_err_ratelimited("%s: id=%d status=%x\n", __func__, msm_host->id, status);
