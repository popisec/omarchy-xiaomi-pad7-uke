 MODULE_PARM_DESC(uke_stream_match,
 	"UKE (K3): 1 (defecto) = stream matching normal; 0 = para el apps-smmu (0x15000000) fuerza el camino stream-indexing sin SMR (ni barrido ni escrituras SMR en el reset).");
 
+/*
+ * UKE-SMMU-CLK (K4): "NO TOCAR lo que dejo el bootloader" (semantica del handoff
+ * del driver vendor: el stock no barre SMR, solo programa los qcom,handoff-smrs).
+ *
+ * CONTEXTO MEDIDO (K2/K3, 28-sep-2026; consola out/uke-ubuntu_console.log [47.71]):
+ * el probe real del apps-smmu SOBREVIVE a IDR0 (0x4c017e6e, SMS=110 grupos),
+ * IDR1 (0x60000047, NUMPAGENDXB=6, 71 CBs), IDR2, a la escritura+relectura del
+ * S2CR(109) del quirk qcom (0x000100ff -> 0x000200ff: quirk=SI) y a la LECTURA de
+ * SMR(0) = 0x80000060 (valid=1, id=0x60, mask=0x8000: un mapeo VIVO del
+ * bootloader). Y MUERE en arm_smmu_device_reset fase2 (arm-smmu.c:1788-1790): el
+ * bucle de arm_smmu_write_sme() x110 que ESCRIBE los 110 S2CR y los 110 SMR.
+ * La ultima miga antes del silencio es "reset fase2 SMR/S2CR x110".
+ *
+ * uke_keep_boot=1 (SOLO apps-smmu, reg=0x15000000, guarda uke_smmu_es_apps()):
+ *   - el reset OMITE ENTERA la fase2: no se escribe NI UN SMR ni UN S2CR (ni clear
+ *     ni repoblar). Los registros del bootloader quedan como estan;
+ *   - arm_smmu_test_smr_masks() (que tambien escribe SMR) tampoco toca el HW:
+ *     se asume el campo MASK completo (ver la funcion) para no romper la
+ *     validacion de arm_smmu_probe_device();
+ *   - el resto de fases dependen de uke_reset_mask (por defecto, con keep_boot=1:
+ *     fases 3, 4 y 5-7 SI, fase2 NO).
+ *
+ * uke_reset_mask (SOLO apps-smmu; bit a 1 = EJECUTAR la fase, bit a 0 = saltarla):
+ *   bit0 = fase2 SMR/S2CR x110          bit2 = fase4 TLBIALLH/TLBIALLNSNH
+ *   bit1 = fase3 CBAR/SCTLR/FSR x71     bit3 = fase5+6+7: RMW de sCR0,
+ *                                               impl->reset y tlb_sync+sCR0
+ * La fase1 (sGFSR) se ejecuta SIEMPRE: es un RMW que reescribe el mismo valor y en
+ * las 3 medidas previas (K1/K2/K3) paso sin incidentes. La mascara efectiva la
+ * calcula uke_reset_mask_efectiva(): el default 0xffff solo cambia (a ~bit0)
+ * cuando uke_keep_boot=1 y el usuario NO ha escrito uke_reset_mask; si el usuario
+ * la escribe, manda ese valor tal cual (asi 0xffff vuelve a activar la fase2).
+ */
+static bool uke_keep_boot;
+static int uke_reset_mask = 0xffff;
+static bool uke_reset_mask_tocado;
+
+#define UKE_RESET_F2		BIT(0)
+#define UKE_RESET_F3		BIT(1)
+#define UKE_RESET_F4		BIT(2)
+#define UKE_RESET_F567		BIT(3)
+#define UKE_RESET_BITS		(UKE_RESET_F2 | UKE_RESET_F3 | UKE_RESET_F4 | UKE_RESET_F567)
+
+static int uke_keep_boot_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (ret)
+		return ret;
+	pr_info("UKE-POKE: uke_keep_boot=%d (solo apps-smmu): fase2 SMR/S2CR %s y test_smr_masks %s\n",
+		uke_keep_boot,
+		uke_keep_boot ? "OMITIDA" : "normal",
+		uke_keep_boot ? "sin tocar HW" : "normal");
+	return 0;
+}
+
+static const struct kernel_param_ops uke_keep_boot_ops = {
+	.set	= uke_keep_boot_set,
+	.get	= param_get_bool,
+};
+
+module_param_cb(uke_keep_boot, &uke_keep_boot_ops, &uke_keep_boot, 0644);
+MODULE_PARM_DESC(uke_keep_boot,
+	"UKE (K4): 1 = apps-smmu (0x15000000): el reset NO escribe ningun SMR ni S2CR (fase2 omitida) y test_smr_masks no toca la region: los mapeos del bootloader quedan intactos. 0 (defecto) = reset mainline.");
+
+static int uke_reset_mask_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_int(val, kp);
+
+	if (ret)
+		return ret;
+	uke_reset_mask_tocado = true;
+	pr_info("UKE-POKE: uke_reset_mask=%d (0x%x, efectivo 0x%x) fijado a mano: fase2=%u fase3=%u fase4=%u fase5-7=%u (1=ejecutar)\n",
+		uke_reset_mask, (unsigned int)uke_reset_mask,
+		(unsigned int)((unsigned int)uke_reset_mask & UKE_RESET_BITS),
+		(uke_reset_mask & UKE_RESET_F2) ? 1u : 0u,
+		(uke_reset_mask & UKE_RESET_F3) ? 1u : 0u,
+		(uke_reset_mask & UKE_RESET_F4) ? 1u : 0u,
+		(uke_reset_mask & UKE_RESET_F567) ? 1u : 0u);
+	return 0;
+}
+
+static const struct kernel_param_ops uke_reset_mask_ops = {
+	.set	= uke_reset_mask_set,
+	.get	= param_get_int,
+};
+
+module_param_cb(uke_reset_mask, &uke_reset_mask_ops, &uke_reset_mask, 0644);
+MODULE_PARM_DESC(uke_reset_mask,
+	"UKE (K4): mascara de fases del reset del apps-smmu (bit0=fase2 SMR/S2CR, bit1=fase3 CBAR/SCTLR/FSR, bit2=fase4 TLBI, bit3=fase5-7 sCR0/impl/tlb); bit a 1 = EJECUTAR. Default 0xffff; con uke_keep_boot=1 y sin tocar, el default pasa a 0xfffe (no fase2).");
+
+/* Mascara efectiva del reset: uke_keep_boot/uke_reset_mask solo afectan al apps-smmu. */
+static u32 uke_reset_mask_efectiva(struct arm_smmu_device *smmu)
+{
+	if (!uke_smmu_es_apps(smmu))
+		return UKE_RESET_BITS;	/* otros SMMU (kgsl): reset completo de mainline */
+
+	if (uke_reset_mask_tocado)
+		return (u32)uke_reset_mask & UKE_RESET_BITS;
+
+	if (uke_keep_boot)
+		return UKE_RESET_BITS & ~UKE_RESET_F2;
+
+	return UKE_RESET_BITS;
+}
