+/*
+ * UKE-SMMU-CLK (K3): palanca "sin stream matching" para el apps-smmu.
+ *
+ * ATENCIÓN: mainline NO tiene un campo smmu->stream_matching. El modo stream
+ * matching ES, en este driver, el par (ARM_SMMU_FEAT_STREAM_MATCH en
+ * smmu->features && smmu->smrs != NULL), y se decide en arm_smmu_device_cfg_probe
+ * a partir del bit SMS de IDR0 (arm-smmu.c:1907-1924). "Forzar que no haya stream
+ * matching" = no leer ese bit/limpiarlo, no alojar smmu->smrs y dejar que el
+ * índice de S2CR sea el stream ID crudo (arm_smmu_find_sme: "Stream indexing is
+ * blissfully easy", arm-smmu.c:1113-1115).
+ *
+ * Con uke_stream_match=0, para el apps-smmu (reg=0x15000000) y solo para él:
+ *   - no se aloja smmu->smrs  => arm_smmu_write_sme() NO escribe un solo SMR
+ *     (arm-smmu.c:1061-1066: "if (smmu->smrs) arm_smmu_write_smr(...)");
+ *   - el barrido de SMR de qcom_smmu_cfg_probe se salta (no hay smrs que poblar);
+ *   - arm_smmu_device_reset() fase2 sigue escribiendo S2CR(0..num_mapping_groups-1)
+ *     (arm-smmu.c:1753-1754) pero NINGÚN SMR.
+ *
+ * Qué queda a cambio (importante): el hardware de este aparato declara SMS=1
+ * (ID0=0x4c017e6e), NUMSMRG=110 y NUMSIDB=15. El modo fiel de mainline sería
+ * num_mapping_groups = 1<<NUMSIDB = 32768 => el reset escribiría 32768 S2CR
+ * (0xc00..0x20bfc) y el attach del mdss (SID 0x1c00) S2CR(7168) en 0x7c00:
+ * registros FUERA del banco de S2CR comprobado (0xc00..0xdb8 = S2CR(0..109),
+ * el último lo releyó K2 con éxito). Para que esta palanca no cambie un cuelgue
+ * por otro, K3 deja num_mapping_groups = NUMSMRG (110) — todo acceso del reset y
+ * del quirk queda dentro del banco ya probado — y aloja s2crs con 1<<NUMSIDB
+ * entradas para que un maestro con SID >= 110 no desborde el array al attacharse.
+ * Es una configuración deliberadamente NO fiel a mainline (documentada en
+ * INFORME-K3-BUILD.md): sirve para responder "¿el probe llega al final (bind)
+ * sin tocar ni un SMR?", no para dejar el SMMU traduciendo de verdad.
+ */
+static bool uke_stream_match = true;
+module_param(uke_stream_match, bool, 0644);
+MODULE_PARM_DESC(uke_stream_match,
+	"UKE (K3): 1 (defecto) = stream matching normal; 0 = para el apps-smmu (0x15000000) fuerza el camino stream-indexing sin SMR (ni barrido ni escrituras SMR en el reset).");
+
 static inline int arm_smmu_rpm_get(struct arm_smmu_device *smmu)
 {
 	if (pm_runtime_enabled(smmu->dev))
@@ -1826,6 +1862,8 @@
