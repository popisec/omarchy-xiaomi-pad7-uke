 {
 	unsigned int size;
+	/* UKE-SMMU-CLK (K3): != 0 solo si uke_stream_match=0 forzó stream-indexing. */
+	unsigned int uke_stream_indexing_groups = 0;
 	u32 id;
 	bool cttw_reg, cttw_fw = smmu->features & ARM_SMMU_FEAT_COHERENT_WALK;
 	int i, ret;
@@ -1904,6 +1942,40 @@
 		size = 1 << FIELD_GET(ARM_SMMU_ID0_NUMSIDB, id);
 	}
 	smmu->streamid_mask = size - 1;
+
+	/*
+	 * UKE-SMMU-CLK (K3): palanca uke_stream_match=0 (ver el bloque del param).
+	 * Se hace AQUÍ, en la lectura de ID0 y antes de alojar smmu->smrs, porque es
+	 * el único punto en el que se decide el modo y porque el barrido de SMR del
+	 * qcom_smmu_cfg_probe (que es lo que cuelga) corre unas líneas más abajo:
+	 * forzarlo "justo antes del reset" no serviría, el barrido ya habría leído
+	 * los SMR. Con el bit SMS limpio, el driver sigue el camino stream-indexing
+	 * normal de mainline (sin smrs, s2crs de 1<<NUMSIDB entradas).
+	 *
+	 * num_mapping_groups se capa después a NUMSMRG (110) en vez de dejarlo en
+	 * 1<<NUMSIDB (32768): así el reset (que recorre num_mapping_groups
+	 * escribiendo S2CR) y el test del quirk (S2CR(127) o S2CR(109)) no salen del
+	 * banco de S2CR comprobado. NO es la config fiel de mainline; es la palanca
+	 * de diagnóstico (INFORME-K3-BUILD.md).
+	 */
+	if (!uke_stream_match && uke_smmu_es_apps(smmu)) {
+		if (id & ARM_SMMU_ID0_SMS) {
+			unsigned int uke_numsmrg = FIELD_GET(ARM_SMMU_ID0_NUMSMRG, id);
+
+			uke_stream_indexing_groups = uke_numsmrg ? uke_numsmrg : 1;
+			pr_info("UKE-POKE: cfg_probe: uke_stream_match=0 -> apps-smmu forzado a STREAM-INDEXING "
+				"sin SMR: smrs=NULL, s2crs[%u] (1<<NUMSIDB=%u), num_mapping_groups=%u (capeado a NUMSMRG, "
+				"no a 1<<NUMSIDB, para no tocar S2CR fuera de 0..%u); ni el barrido ni el reset tocaran SMR\n",
+				(unsigned int)(1u << FIELD_GET(ARM_SMMU_ID0_NUMSIDB, id)),
+				(unsigned int)(1u << FIELD_GET(ARM_SMMU_ID0_NUMSIDB, id)),
+				uke_stream_indexing_groups,
+				uke_numsmrg ? uke_numsmrg - 1 : 0);
+			id &= ~ARM_SMMU_ID0_SMS;	/* mainline ya no ve el bit SMS */
+		} else {
+			pr_warn("UKE-POKE: cfg_probe: uke_stream_match=0 pero el hw no reporta SMS; nada que forzar\n");
+		}
+	}
+
 	if (id & ARM_SMMU_ID0_SMS) {
 		smmu->features |= ARM_SMMU_FEAT_STREAM_MATCH;
 		size = FIELD_GET(ARM_SMMU_ID0_NUMSMRG, id);
@@ -1930,7 +2002,13 @@
 	for (i = 0; i < size; i++)
 		smmu->s2crs[i] = s2cr_init_val;
 
-	smmu->num_mapping_groups = size;
+	/*
+	 * UKE-SMMU-CLK (K3): con el modo stream-indexing forzado, la s2crs se aloja
+	 * con 1<<NUMSIDB entradas (size, arriba) pero num_mapping_groups se queda en
+	 * NUMSMRG: así ningún bucle del driver sale del banco de S2CR probado y un
+	 * SID alto (mdss = 0x1c00) no desborda s2crs al attacharse.
+	 */
+	smmu->num_mapping_groups = uke_stream_indexing_groups ? uke_stream_indexing_groups : size;
 	mutex_init(&smmu->stream_map_mutex);
 	spin_lock_init(&smmu->global_sync_lock);
 
