+		 * consola enmudece, la última línea "SMR[i] -> readl" es el índice
+		 * que mata; la línea "SMR[i] = 0x..." de después es el noop-check
+		 * (confirma que la lectura devolvió un valor).
+		 */
+		pr_info("UKE-POKE: SMR[%d] -> readl(0x%x)\n", i, ARM_SMMU_GR0_SMR(i));
 		smr = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_SMR(i));
+		pr_info("UKE-POKE: SMR[%d] = 0x%08x (valid=%u id=0x%x mask=0x%x)\n", i, smr,
+			(unsigned int)FIELD_GET(ARM_SMMU_SMR_VALID, smr),
+			(unsigned int)FIELD_GET(ARM_SMMU_SMR_ID, smr),
+			(unsigned int)FIELD_GET(ARM_SMMU_SMR_MASK, smr));
 
 		if (FIELD_GET(ARM_SMMU_SMR_VALID, smr)) {
 			n_validos++;
@@ -537,7 +614,8 @@
 			smmu->s2crs[i].cbndx = 0xff;
 		}
 	}
-	pr_info("UKE-POKE: qcom_cfg_probe: SMR loop OK (validos=%u)\n", n_validos);
+	pr_info("UKE-POKE: qcom_cfg_probe: SMR loop OK (leidos=%u validos=%u)\n",
+		uke_smr_limite, n_validos);
 
 	return 0;
 }
