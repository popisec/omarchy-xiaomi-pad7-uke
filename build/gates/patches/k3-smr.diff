+/*
+ * UKE-SMMU-CLK (K3): palanca de salto del barrido de SMR de qcom_smmu_cfg_probe.
+ *
+ * QUÉ ES ESTE BARRIDO (diagnóstico del encargo K3). El bucle de abajo es código
+ * FUNCIONAL de mainline, no una miga del proyecto: está en el árbol prístino
+ * (palawan-linux/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c:516-530) y lo único
+ * que añadieron K1/K2 fueron los pr_info. Lo que hace con cada valor leído:
+ * poblar smmu->smrs[] y smmu->s2crs[] con el estado que el firmware dejó grabado
+ * (SMR VALID -> id/mask/valid y S2CR a BYPASS/cbndx 0xff). Su efecto es que el
+ * arm_smmu_device_reset posterior REESCRIBE esas mismas entradas en vez de
+ * invalidarlas todas: es el equivalente mainline del qcom,handoff-smrs del driver
+ * vendor (el DT del aparato trae qcom,handoff-smrs = <0x1c00 0x02>, que es
+ * justamente el SID del mdss). Si el barrido no se hace, el driver arranca con
+ * smrs[] todo a cero (invalid) y el reset invalida los SMR del bootloader.
+ *
+ * En la tablet, K2 midió que el probe del apps-smmu muere dentro de este bucle
+ * (última línea: "leyendo SMR(0..109)"). Esta palanca sirve para (a) localizar el
+ * índice exacto que mata y (b) saltar el barrido entero si resulta que sin él el
+ * probe llega al final (bind).
+ *
+ * Semántica (leída en cada barrido; escribible en caliente, 0644):
+ *   uke_smr_max = -1 (defecto) o >= 109 : bucle completo (comportamiento actual)
+ *   uke_smr_max =  0 .. 108             : solo se leen SMR(0..uke_smr_max)
+ *   uke_smr_max = -2                    : NO se lee ningún SMR (bucle saltado)
+ *
+ * Ojo: -2 salta SOLO este barrido. El reset (arm_smmu_write_sme -> SMR) sigue
+ * escribiendo los SMR; si el cuelgue fuese la región (no el índice), moriría en
+ * "reset fase2". Para ese caso está la otra palanca, uke_stream_match=0
+ * (arm-smmu.c), que quita TODO acceso a SMR (barrido y reset).
+ */
+static int uke_smr_max = -1;
+module_param(uke_smr_max, int, 0644);
+MODULE_PARM_DESC(uke_smr_max,
+	"UKE (K3): limite del barrido SMR de qcom_smmu_cfg_probe: -1/>=109 = todos, 0..108 = solo hasta ese indice, -2 = saltar el barrido entero sin leer ningun SMR.");
+
 static int qcom_smmu_cfg_probe(struct arm_smmu_device *smmu)
 {
 	struct qcom_smmu *qsmmu = to_qcom_smmu(smmu);
@@ -455,6 +491,7 @@
 	u32 smr;
 	int i;
 	unsigned int n_validos = 0;
+	unsigned int uke_smr_limite;
 
 	/*
 	 * MSM8998 LPASS SMMU reports 13 context banks, but accessing
@@ -519,10 +556,50 @@
 		}
 	}
 
-	pr_info("UKE-POKE: qcom_cfg_probe: leyendo SMR(0..%u)\n",
-		smmu->num_mapping_groups - 1);
-	for (i = 0; i < smmu->num_mapping_groups; i++) {
+	/*
+	 * UKE-SMMU-CLK (K3): sin smmu->smrs (uke_stream_match=0, o hw sin SMS) este
+	 * barrido no tiene sentido: los SMR son los registros del modo stream-matching
+	 * y no hay arrays que poblar. Mainline no leería SMR en ese modo; aquí se dice
+	 * y se sale, para no tocar la región que cuelga.
+	 */
+	if (!smmu->smrs) {
+		pr_info("UKE-POKE: qcom_cfg_probe: smrs==NULL (sin stream matching): barrido SMR no aplica, SALTADO sin leer ni un SMR\n");
+		return 0;
+	}
+
+	/*
+	 * UKE-SMMU-CLK (K3): -2 = no leer ninguno (palanca de salto del barrido).
+	 */
+	if (uke_smr_max == -2) {
+		pr_info("UKE-POKE: qcom_cfg_probe: barrido SMR SALTADO ENTERO (uke_smr_max=-2): no se lee ni un SMR; grupos=%u\n",
+			smmu->num_mapping_groups);
+		return 0;
+	}
+
+	/*
+	 * UKE-SMMU-CLK (K3): límite del barrido (uke_smr_max=0 -> solo SMR(0)).
+	 * -1 o cualquier valor >= num_mapping_groups-1 = bucle completo de siempre.
+	 */
+	uke_smr_limite = smmu->num_mapping_groups;
+	if (uke_smr_max >= 0 && (unsigned int)uke_smr_max < uke_smr_limite)
+		uke_smr_limite = (unsigned int)uke_smr_max + 1;
+
+	pr_info("UKE-POKE: qcom_cfg_probe: leyendo SMR(0..%u) [uke_smr_max=%d grupos=%u]\n",
+		uke_smr_limite - 1, uke_smr_max, smmu->num_mapping_groups);
+	for (i = 0; i < uke_smr_limite; i++) {
+		/*
+		 * UKE-SMMU-CLK (K3): miga por índice ANTES de la lectura (sin
