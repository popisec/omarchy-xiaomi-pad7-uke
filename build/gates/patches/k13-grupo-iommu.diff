+				dev_info(dev,
+					 "UKE-K13: msm_iommu_new: iommu_attach_group rc=%d\n",
+					 ret);
+			}
+			iommu_group_put(group);
+		}
+	}
 	if (ret) {
 		iommu_domain_free(domain);
 		kfree(iommu);
