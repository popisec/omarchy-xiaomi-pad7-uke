+	 * dpu moria en "dpu_kms_mmu_init failed: -22" SIN llegar a
+	 * arm_smmu_attach_dev (por eso el boot K12 no tenia migas "CB reservado"
+	 * del dominio del display). La banda 0x1c00 es UNA traduccion fisica
+	 * compartida: attacheo del GRUPO entero (iommu_attach_group no tiene el
+	 * check de count) es la semantica correcta. Los grupos de un solo
+	 * dispositivo (todos los demas targets y maestros) no entran al fallback.
+	 */
+	if (ret == -EINVAL) {
+		struct iommu_group *group = iommu_group_get(dev);
+		unsigned int ndev = 0;
+
+		if (group) {
+			iommu_group_for_each_dev(group, &ndev,
