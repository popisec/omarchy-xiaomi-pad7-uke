# uke-wifi-fw.sha256 - firmware WCN6750 que uke-wifi-up.sh exige antes de arrancar el WPSS.
# Verificable en la tablet con:  cd / && sha256sum -c usr/lib/firmware/uke-wifi-fw.sha256
# Origen (todos medidos == a /vendor/firmware_mnt/image/qca6750 del Android VIVO, 17-oct-2026,
# build/android/sistema-20261017/firmware-sha.txt):
#   board.bin  = qca6750/bd_o82gl.elf COMPLETO (ELF, 59928 B). ath11k lo manda como BDF_TYPE_ELF (=1)
#                y NO pide caldata (qmi.c); el payload crudo da424c03 (BDF_TYPE_BIN) exigiria
#                cal-ahb-*.bin/caldata.bin y el kernel senemos NO lleva el poke que lo perdona.
#   regdb.bin  = qca6750/regdb_xiaomi.bin (el que pide el icnss2 vivo).
#   wpss.*     = set COMPLETO del WPSS del vendor (mdt + b00..b10 + b12; el b11 no existe: filesz=0).
#                Coherente por construccion: cada segmento (sha384) esta en la tabla de hashes de b12.
