+static void
+uke_af_start(struct camera_info *info)
+{
+        if (info->lens_fd < 0)
+                return;
+        uke_af_state = 1;
+        uke_af_idx = 0;
+        uke_af_bestv = -1;
+        uke_af_minv = 1e30;
+        uke_af_best = 0;
+        uke_af_wait = 2;
+        uke_set_focus(info->lens_fd, 0);
+        printf("uke-af: barrido\n");
+}
