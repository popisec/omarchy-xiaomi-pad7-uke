+/*
+ * uke (0007): autofoco por contraste por software con la lente del enlace auxiliar (VCM CN3927V, subdev dw9714, focus_absolute 0..1023).
+ * Barrido grueso (13 posiciones) + fino (+-64 en 6), 2 tramas de espera tras cada movimiento; contraste de pixeles del mismo color en el
+ * 50 % central, normalizado por el brillo. La AE se pausa durante el barrido. Se lanza al abrir la camara (cuando la AE se ha asentado)
+ * y al tocar el preview.
+ */
+static int uke_af_state; /* 0 parado, 1 grueso, 2 fino */
+static int uke_af_idx, uke_af_wait, uke_af_best, uke_af_lo, uke_af_pending = -1;
