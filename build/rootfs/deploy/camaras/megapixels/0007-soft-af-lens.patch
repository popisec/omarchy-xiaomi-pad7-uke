+uke_set_focus(int fd, int pos)
+{
+        struct v4l2_control c = { .id = V4L2_CID_FOCUS_ABSOLUTE, .value = pos };
+        if (ioctl(fd, VIDIOC_S_CTRL, &c) == -1)
+                printf("uke-af: VIDIOC_S_CTRL %d: %s\n", pos, strerror(errno));
+}
+
+static double
+uke_sharpness(const MPBuffer *buffer)
+{
+        uint32_t row_bytes = mp_pixel_format_width_to_bytes(mode.pixel_format, mode.width);
+        uint32_t bpl = row_bytes + mp_pixel_format_width_to_padding(mode.pixel_format, mode.width);
+        bool p10 = mp_pixel_format_bits_per_pixel(mode.pixel_format) == 10;
+        double s = 0, b = 1;
+        for (uint32_t y = mode.height / 4 & ~1u; y + 2 < mode.height * 3 / 4; y += 4) {
+                const uint8_t *r = buffer->data + (size_t)y * bpl, *r2 = r + 2 * (size_t)bpl;
+                for (uint32_t x = row_bytes / 4; x + 5 < row_bytes * 3 / 4; x += p10 ? 5 : 4) {
+                        /* pixeles del mismo color: +2 en la fila y +2 filas */
+                        s += abs(r[x] - r[x + 2]) + abs(r[x + 1] - r[x + 3]) + abs(r[x] - r2[x]) + abs(r[x + 1] - r2[x + 1]);
+                        b += r[x] + r[x + 1] + r[x + 2] + r[x + 3];
+                }
+        }
+        return s / b;
+}
