+/* uke: cambia la matriz de color (fila mayor) sin reconfigurar el debayer; la usa el balance de blancos por software */
+void
+gles2_debayer_set_matrix(GLES2Debayer *self, const float *matrix)
+{
+        GLfloat transposed[9];
+        for (int i = 0; i < 3; ++i)
+                for (int j = 0; j < 3; ++j)
+                        transposed[i + j * 3] = matrix[j + i * 3];
+        glUseProgram(self->program);
+        glUniformMatrix3fv(self->uniform_color_matrix, 1, GL_FALSE, transposed);
+}
