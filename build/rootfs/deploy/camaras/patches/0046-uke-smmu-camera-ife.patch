# 0046-uke-smmu-camera-ife.patch — omarchy-uke (20-oct-2026)
#
# Delta PROPIO del proyecto sobre el arbol «senemos» (MCC45TR): da de alta el contexto
# S1 de la IFE de camaras en el SMMU (actlr 0x800/mask 0x20) y ajusta el uke-display-smmu.
# Informe: build/gates/revision/CAMARAS-PLAN-20261019.md.
#
# Se aplica sobre ficheros GPL-2.0-only del kernel, asi que hereda esa licencia.
# SPDX-License-Identifier: GPL-2.0-only
#
--- a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c	2026-10-20 12:40:37.912768001 +0200
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c	2026-10-20 12:40:37.945258031 +0200
@@ -845,10 +845,15 @@
 		       /* FastRPC ADSP compute-cb 3..7 (sm8650.dtsi:4517-4561), see 0004 */
 		       sid == 0x801003 || sid == 0x201043 || sid == 0x801004 || sid == 0x201044 ||
 		       sid == 0x801005 || sid == 0x201045 || sid == 0x801006 || sid == 0x201046 ||
-		       sid == 0x401007 || sid == 0x1067 || sid == 0x1087) &&
+		       sid == 0x401007 || sid == 0x1067 || sid == 0x1087 ||
+		       /* camera IFE <0x800 mask 0x20> (camss, 0046); ACTLR applied in qcom_uke_display_init_context() */
+		       sid == UKE_CAMERA_IFE_SID) &&
 		      of_device_is_compatible(smmu->dev->of_node, "qcom,sm7675-boot-smmu")))
 			return dev_err_probe(dev, -EOPNOTSUPP, "outside Uke boot SMMU scope\n");
-		/* None of these streams has an ACTLR override in OEM Cliffs DT. */
+		/* The camera IFE has one (0x800/0x20 -> 0x1, CMTLB): applied at context init, not a reason to refuse. */
+		if (sid == UKE_CAMERA_IFE_SID)
+			continue;
+		/* None of the other streams has an ACTLR override in OEM Cliffs DT. */
 		for (j = 0; actlr && j < len / sizeof(u32); j += 3)
 			if (!((FIELD_GET(ARM_SMMU_SMR_ID, sid) ^ be32_to_cpu(actlr[j])) &
 			      ~be32_to_cpu(actlr[j + 1])))
--- a/drivers/iommu/arm/arm-smmu/uke-display-smmu.c	2026-10-20 12:40:37.912928532 +0200
+++ b/drivers/iommu/arm/arm-smmu/uke-display-smmu.c	2026-10-20 12:40:37.945398821 +0200
@@ -94,6 +94,26 @@
 		spec && spec->num_ids == 1 && spec->ids[0] == 0x00021c00;
 }
 
+/* Camera IFE stream <0x800 mask 0x20>: fwspec id = sid | mask << 16. */
+#define UKE_CAMERA_IFE_SID	0x200800
+
+static int qcom_uke_camera_init_context(struct arm_smmu_domain *domain, struct device *dev)
+{
+	struct arm_smmu_device *smmu = domain->smmu;
+	u32 value;
+
+	if (!of_device_is_compatible(dev->of_node, "qcom,cliffs-camss"))
+		return 0;
+	if (domain->stage != ARM_SMMU_DOMAIN_S1)
+		return -EOPNOTSUPP;
+	/* OEM Cliffs ACTLR table: 0x800/mask 0x20 -> 0x1 (CMTLB). New, stopped context only. */
+	arm_smmu_cb_write(smmu, domain->cfg.cbndx, ARM_SMMU_CB_ACTLR, 1);
+	value = arm_smmu_cb_read(smmu, domain->cfg.cbndx, ARM_SMMU_CB_ACTLR);
+	if (value != 1)
+		return dev_err_probe(dev, -EACCES, "camera ACTLR write did not stick\n");
+	return 0;
+}
+
 static int qcom_uke_display_init_context(struct arm_smmu_domain *domain,
 				       struct io_pgtable_cfg *cfg, struct device *dev)
 {
@@ -101,7 +121,7 @@
 	u32 value;
 
 	if (!qcom_uke_display_domain(smmu, dev))
-		return 0; /* Existing USB/GPI behavior is unchanged. */
+		return qcom_uke_camera_init_context(domain, dev); /* USB/GPI: unchanged */
 	if (domain->stage != ARM_SMMU_DOMAIN_S1)
 		return -EOPNOTSUPP;
 	/* OEM Cliffs ACTLR table: 1c00/mask-2 -> 1. New, stopped context only. */
