+++ fork/input-method-unstable-v2.xml	2026-10-18 17:50:38.041931383 +0200
@@ -0,0 +1,494 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="input_method_unstable_v2">
+
+  <copyright>
