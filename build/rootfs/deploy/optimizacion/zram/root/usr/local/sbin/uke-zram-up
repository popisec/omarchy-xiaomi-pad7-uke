#!/bin/bash
# uke-zram-up — swap comprimido en RAM (zstd) para la tablet de 7,4 GiB. 22-oct-2026. Requiere kernel v7 (CONFIG_ZRAM=m).
# Tamano = ZRAM_MB (def. 4096) sobre /dev/zram0, prioridad 100. Guarda: sin modulo zram sale 0 sin hacer nada.
set -u
MB=${ZRAM_MB:-4096}
modprobe zram 2>/dev/null || { echo "uke-zram: sin modulo zram (kernel sin CONFIG_ZRAM): nada que hacer"; exit 0; }
[ -b /dev/zram0 ] || { echo "uke-zram: sin /dev/zram0"; exit 0; }
swapon --show=NAME --noheadings | grep -q zram0 && { echo "uke-zram: zram0 ya activo"; exit 0; }
echo zstd > /sys/block/zram0/comp_algorithm 2>/dev/null || echo lz4 > /sys/block/zram0/comp_algorithm
echo "${MB}M" > /sys/block/zram0/disksize || exit 1
echo "$((MB * 3 / 4))M" > /sys/block/zram0/mem_limit 2>/dev/null   # tope de RAM real ocupada por el swap (datos incompresibles)
mkswap -L uke-zram /dev/zram0 >/dev/null && swapon -p 100 /dev/zram0 && echo "uke-zram: ${MB} MiB $(cat /sys/block/zram0/comp_algorithm | grep -o '\[[^]]*\]')"
