# Fragmento de .config para el siguiente kernel (propuesta 21-oct-2026; NO aplicado, sin build).
# Aplicar sobre senemos-build/.config con: scripts/kconfig/merge_config.sh -m .config este-fichero && make olddefconfig
# (con env MAKE=/usr/bin/make ARCH=arm64, build desprendido con setsid nohup; coordinar con la sesion de camaras: mismo arbol).
# K-1 zram: memoria 7,4 GiB sin swap (CONFIG_ZRAM y ZSWAP no estan). Como modulo: sobrevive en extra/ y se carga bajo demanda.
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
# K-2 governor cpuidle TEO (hoy menu; con ~300 timers/s y estados de 3-8 ms de residencia suele acertar mejor).
CONFIG_CPU_IDLE_GOV_TEO=y
# K-3 PSI para medir presion de memoria/CPU/IO (necesario para zram-tuning y herramientas tipo earlyoom/systemd-oomd).
CONFIG_PSI=y
