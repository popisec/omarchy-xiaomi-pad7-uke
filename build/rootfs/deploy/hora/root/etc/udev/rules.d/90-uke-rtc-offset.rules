# rtc-pm8xxx es un modulo: rtc0 aparece tarde en el arranque. Al aparecer, restaurar la hora (uke-rtc-offset.service).
# (sin TAG systemd no existe dev-rtc0.device y el servicio corria antes del RTC: medido en el arranque ouke5 del 19-oct)
ACTION=="add", SUBSYSTEM=="rtc", KERNEL=="rtc0", TAG+="systemd", ENV{SYSTEMD_WANTS}+="uke-rtc-offset.service"
