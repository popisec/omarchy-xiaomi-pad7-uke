+    def write_regs(self, addr, payload):
+        """set_page + escritura [addr&0x7F|0x80, payload...] (como uke-touch-fwload.py); lo usa uke_pen.PenChip."""
+        tx = self.tx
+        tx[0], tx[1], tx[2] = 0xFF, (addr >> 15) & 0xFF, (addr >> 7) & 0xFF
+        tx[3] = 0
+        self._xfer(4)
+        tx[0] = (addr & 0x7F) | 0x80
+        for i, b in enumerate(payload):
+            tx[1 + i] = b
+        self._xfer(1 + len(payload))
+        for i in range(len(payload) + 1):                  # read() restaura tx[0..2]; el resto del buffer debe quedar a cero
+            tx[i] = 0
+
