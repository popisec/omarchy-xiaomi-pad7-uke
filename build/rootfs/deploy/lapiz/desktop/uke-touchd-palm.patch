+class PalmGuard:
+    """Rechazo de palma con lapiz: bloquea dedos mientras el lapiz esta en rango y `hold` s despues del ultimo frame de lapiz; los toques
+    que aparecieron durante el bloqueo (tid) siguen ignorados mientras no se levanten (la palma que vuelve a los 0,25-0,5 s)."""
+
+    def __init__(self, hold=0.5, area=0):
+        self.hold, self.area, self.until, self.ban = hold, area, -1e9, set()
+
+    def pen_seen(self, now):
+        self.until = now + self.hold
+
+    def blocked(self, now, in_range=False):
+        return in_range or now < self.until
+
+    def filter(self, pts, now, in_range=False):
+        """pts = [(tid, x, y, area)]. Devuelve (puntos permitidos, hay_que_cancelar_los_activos)."""
+        blocked = self.blocked(now, in_range)
+        alive = {p[0] for p in pts}
+        self.ban &= alive
+        if blocked:
+            self.ban |= alive
+        if self.area:
+            self.ban |= {p[0] for p in pts if p[3] >= self.area}
+        return [p for p in pts if p[0] not in self.ban], blocked
+
+
