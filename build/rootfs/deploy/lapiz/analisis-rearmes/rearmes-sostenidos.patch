+    def test_no_rearm_for_stale_backlog_or_fresh_enable(self):
+        # 20-oct: tras un parón del cliente BLE llega de golpe un volcado de presion que acaba en 0 (y luego «pegado»); y el 1.er informe de una rafaga
+        # llega <1 s despues del enable, antes de que el chip pueda dar frames. Ninguno debe re-armar.
+        rt, spi, ui = self.make()
+        self.send(rt, {"connected": True, "attached": False}); rt.on_socket(10.0)        # enable en 10.0
+        for p in (500, 900, 700, 0):
+            self.send(rt, {"pressure": p})
+        rt.on_socket(30.0)                                                               # volcado atrasado que termina en 0
+        spi.writes.clear()
+        rt.tick(30.1); rt.tick(31.5)
+        self.assertEqual((spi.writes, rt.rearms), ([], 0))
+        self.send(rt, {"pressure": 300}); rt.on_socket(40.0)                             # presion nueva...
+        rt.tick(40.5)
+        self.assertEqual(rt.rearms, 0)                                                   # ...aun no sostenida 1 s
+        self.send(rt, {"pressure": 0}); rt.on_socket(40.8)                               # se acaba la rafaga: nunca se rearma
+        rt.tick(42.0)
+        self.assertEqual(rt.rearms, 0)
+        self.send(rt, {"pressure": 400}); rt.on_socket(50.0); rt.tick(51.2)              # presion sostenida >1 s sin frames: si se rearma
+        self.assertEqual(rt.rearms, 1)
+
     def test_no_rearm_when_frames_flow_or_no_pressure(self):
